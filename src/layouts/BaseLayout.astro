---
import NewsletterForm from '../components/NewsletterForm.astro';
import { optimizedImage } from '../lib/image';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "BLOSSOM — The Creative World of Olaoluwa Michael",
  description = "Official publishing ecosystem of Olaoluwa Michael: books, faith-based reflections, visual imagination, and creative work by Olaoluwa Michael.",
  image = "/og-image.png",
  canonical,
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = 'https://olaoluwamichael.vercel.app';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
// Social previews (WhatsApp, Facebook, X) need a PNG/JPEG under ~600 KB; SVG is never shown.
const shareImage = optimizedImage(image, 960);
const imageUrl = shareImage.startsWith('http') ? shareImage : new URL(shareImage, siteUrl).toString();
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BLOSSOM',
  alternateName: 'The Creative World of Olaoluwa Michael',
  url: siteUrl,
  description,
  publisher: {
    '@type': 'Person',
    name: 'Olaoluwa Michael',
  },
};
const schemaItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [defaultStructuredData];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1282831461622449"
     crossorigin="anonymous"></script>
    <meta name="google-site-verification" content="VlyFkToelAyvuPTykLqvt1nby6NU3Z1CA6OalHQcSqU" />
    <meta name="author" content="Olaoluwa Michael" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#F7F3EB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('blossom-theme-v2') === 'night') document.documentElement.dataset.theme = 'night';
      } catch {}
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BLOSSOM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {schemaItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Skip to content</a>

    <header class="site-header sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/75">
      <div class="wrap flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
        <a href="/" class="group flex flex-col leading-none" aria-label="BLOSSOM, home">
          <span class="font-display text-[1.45rem] font-semibold tracking-[0.32em] text-ink sm:text-[1.6rem]">BLOSSOM</span>
          <span class="mt-1 font-display text-[0.8rem] italic tracking-[0.04em] text-muted transition-colors group-hover:text-accent">by Olaoluwa Michael</span>
        </a>

        <nav class="hidden items-center gap-9 lg:flex" aria-label="Main">
          <a href="/books" class="nav-link">Books</a>
          <a href="/journal" class="nav-link">Journal</a>
          <a href="/imagination" class="nav-link">Imagination</a>
          <a href="/about" class="nav-link">About</a>
        </nav>

        <div class="flex items-center gap-1.5">
          <button type="button" id="theme-toggle" class="icon-btn" aria-label="Switch to night reading" title="Day / Night">
            <svg class="theme-icon-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7Z" stroke-linejoin="round"/></svg>
            <svg class="theme-icon-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" stroke-linecap="round"/></svg>
          </button>
          <a href="/books" class="btn btn-primary btn-sm hidden sm:inline-flex lg:ml-3">Shop books</a>
          <button type="button" id="mobile-menu-button" class="icon-btn lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden border-t border-line/70 bg-paper lg:hidden" aria-label="Mobile navigation">
        <nav class="wrap flex flex-col py-4" aria-label="Mobile">
          <a href="/" class="mobile-link">Home</a>
          <a href="/books" class="mobile-link">Books</a>
          <a href="/journal" class="mobile-link">Journal</a>
          <a href="/imagination" class="mobile-link">Imagination</a>
          <a href="/about" class="mobile-link">About</a>
          <div class="mt-4 flex flex-wrap gap-2 pb-2">
            <a href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x" target="_blank" rel="noopener noreferrer" class="chip">WhatsApp Channel ↗</a>
            <a href="https://www.facebook.com/share/1DTMt74HuT/" target="_blank" rel="noopener noreferrer" class="chip">Facebook ↗</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-grow">
      <slot />
    </main>

    <section class="band hairline-t" aria-label="Newsletter">
      <div class="wrap py-16 sm:py-20 reveal"><NewsletterForm compact /></div>
    </section>

    <footer class="theme-night bg-paper text-ink-2">
      <div class="wrap grid gap-12 py-16 sm:py-20 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="font-display text-3xl font-semibold tracking-[0.3em] text-ink">BLOSSOM</p>
          <p class="mt-4 max-w-sm font-serif text-[1.05rem] leading-relaxed text-ink-2">Books, quiet reflections and visual stories by Olaoluwa Michael: written to help you grow in faith, in purpose and in becoming.</p>
        </div>
        <div>
          <p class="eyebrow">Explore</p>
          <ul class="mt-5 space-y-3 text-[0.95rem]">
            <li><a href="/books" class="link text-ink-2">Books</a></li>
            <li><a href="/journal" class="link text-ink-2">Journal</a></li>
            <li><a href="/imagination" class="link text-ink-2">Imagination</a></li>
            <li><a href="/about" class="link text-ink-2">About Olaoluwa</a></li>
            <li><a href="/books/other-authors" class="link text-ink-2">Other authors</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Follow along</p>
          <ul class="mt-5 space-y-3 text-[0.95rem]">
            <li><a href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x" target="_blank" rel="noopener noreferrer" class="link text-ink-2">WhatsApp Channel ↗</a></li>
            <li><a href="https://www.facebook.com/share/1DTMt74HuT/" target="_blank" rel="noopener noreferrer" class="link text-ink-2">Facebook ↗</a></li>
            <li><a href="mailto:michaelolaoluwagab@gmail.com" class="link text-ink-2">Write to Olaoluwa</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap flex flex-col gap-2 border-t border-line py-7 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} Olaoluwa Michael · BLOSSOM · Nigeria</p>
        <p class="font-display text-sm italic">Written with faith, from Nigeria.</p>
      </div>
    </footer>


    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById('theme-toggle');
        const meta = document.querySelector('meta[name="theme-color"]');
        const apply = (theme, save) => {
          if (theme === 'night') root.dataset.theme = 'night'; else delete root.dataset.theme;
          if (save) { try { localStorage.setItem('blossom-theme-v2', theme); } catch {} }
          toggle?.setAttribute('aria-label', theme === 'night' ? 'Switch to day reading' : 'Switch to night reading');
          meta?.setAttribute('content', theme === 'night' ? '#141210' : '#F7F3EB');
        };
        apply(root.dataset.theme === 'night' ? 'night' : 'day', false);
        toggle?.addEventListener('click', () => apply(root.dataset.theme === 'night' ? 'day' : 'night', true));

        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        const setOpen = (open) => {
          button?.setAttribute('aria-expanded', String(open));
          button?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menu?.classList.toggle('hidden', !open);
        };
        button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
        menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

        const path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll('.nav-link, .mobile-link').forEach((a) => {
          const href = a.getAttribute('href');
          if (href === path || (href !== '/' && path.startsWith(href + '/'))) a.setAttribute('aria-current', 'page');
        });

        const els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
          }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add('is-in'));
        }
      })();
    </script>
  </body>
</html>
