---
interface Props {
  compact?: boolean;
  heading?: string;
  description?: string;
}

const {
  compact = false,
  heading = 'Stay close to what comes next.',
  description = 'New books, visual stories and quiet reflections from Olaoluwa Michael, delivered to your inbox.',
} = Astro.props;
---

<section class={compact ? 'grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-end md:gap-16' : 'card p-7 sm:p-12'} aria-labelledby="newsletter-title">
  <div class={compact ? '' : 'max-w-2xl'}>
    <p class="eyebrow">The Blossom Letter</p>
    <h2 id="newsletter-title" class="mt-4 text-balance font-display text-[2.1rem] leading-[1.08] sm:text-[2.6rem]">{heading}</h2>
    <p class="mt-4 max-w-md font-serif text-[1.08rem] leading-relaxed text-ink-2">{description}</p>
  </div>
  <div>
    <form id="newsletter-form" class="grid gap-3 sm:grid-cols-[1fr_auto]" novalidate>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input id="newsletter-email" name="email" type="email" required autocomplete="email" maxlength="160" placeholder="Your email address" class="field" />
      <input name="website_url" type="text" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <button type="submit" class="btn btn-primary">Subscribe</button>
    </form>
    <p id="newsletter-status" class="mt-3 min-h-5 text-sm text-muted" aria-live="polite">Free. One gentle email when something new is published. Unsubscribe anytime.</p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('#newsletter-form').forEach((newsletterForm) => {
    const section = newsletterForm.closest('section');
    const newsletterStatus = section?.querySelector('#newsletter-status');
    newsletterForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = newsletterForm.querySelector('button[type="submit"]');
      const emailInput = newsletterForm.querySelector('input[type="email"]');
      const email = emailInput?.value?.trim();

      if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
        if (newsletterStatus) {
          newsletterStatus.textContent = 'Please enter a valid email address.';
          newsletterStatus.className = 'mt-3 min-h-5 text-sm text-wine';
        }
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Subscribing…';
      }
      if (newsletterStatus) {
        newsletterStatus.textContent = 'Adding you to the list…';
        newsletterStatus.className = 'mt-3 min-h-5 text-sm text-muted';
      }

      try {
        const response = await fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'We could not save your subscription.');

        newsletterForm.reset();
        if (newsletterStatus) {
          newsletterStatus.textContent = 'You’re in. The next book, story or reflection will come straight to your inbox.';
          newsletterStatus.className = 'mt-3 min-h-5 text-sm font-medium text-accent';
        }
      } catch (error) {
        if (newsletterStatus) {
          newsletterStatus.textContent = error instanceof Error ? error.message : 'We could not save your subscription.';
          newsletterStatus.className = 'mt-3 min-h-5 text-sm text-wine';
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Subscribe';
        }
      }
    });
  });
</script>
