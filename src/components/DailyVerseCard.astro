---
import type { DailyVerse } from '../lib/daily-verse';
import { longDate, verseUrl, shareText } from '../lib/daily-verse';
import { optimizedImage } from '../lib/image';

interface Props { post: DailyVerse; label?: string }
const { post, label = 'Daily Verse' } = Astro.props;
const url = verseUrl(post);
const text = encodeURIComponent(shareText(post) + '\n' + url);
const note = post.captions?.site || post.caption;
---

<article class="grid items-start gap-8 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-14">
  <figure class="mx-auto w-full max-w-[420px]">
    {post.media_url && (
      <img
        src={optimizedImage(post.media_url, 640, 80)}
        alt={`${post.title}: ${post.reference ?? ''}`}
        width="1080" height="1920"
        class="w-full rounded-[18px] shadow-[0_18px_50px_rgba(60,40,20,.18)]"
        fetchpriority="high" decoding="async"
      />
    )}
  </figure>
  <div>
    <p class="eyebrow">{label} · {longDate(post.post_date)}</p>
    <h1 class="display mt-5 text-[2.8rem] sm:text-[3.8rem]">{post.title}</h1>
    {post.verse && <blockquote class="mt-6 font-serif text-[1.35rem] italic leading-relaxed text-ink sm:text-[1.5rem]">“{post.verse}”</blockquote>}
    {post.reference && <p class="mt-3 font-display text-xl italic text-accent">— {post.reference} (KJV)</p>}
    <p class="lede mt-6">{note}</p>
    {post.hashtags && <p class="meta mt-4">{post.hashtags}</p>}
    <div class="mt-8 flex flex-wrap gap-2">
      <a class="btn btn-primary btn-sm" href={`https://wa.me/?text=${text}`} target="_blank" rel="noopener noreferrer">Share on WhatsApp</a>
      <a class="btn btn-ghost btn-sm" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">Facebook</a>
      <a class="btn btn-ghost btn-sm" href={`https://x.com/intent/post?text=${text}`} target="_blank" rel="noopener noreferrer">X</a>
      {post.media_url && <a class="btn btn-ghost btn-sm" href={`${post.media_url}?download=`} rel="noopener">Save picture</a>}
    </div>
    <p class="mt-8" style="font-family:'Great Vibes',cursive;font-size:2rem;color:rgb(var(--accent))">Olaoluwa Michael</p>
  </div>
</article>
