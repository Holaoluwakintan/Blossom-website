---
interface Props {
  title: string;
  url: string;
  label?: string;
}

const { title, url, label = 'Share this' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(`${title} — ${url}`);
const whatsappUrl = `https://wa.me/?text=${encodedText}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
---

<div class="mt-12 flex flex-col gap-4 border-y border-line py-6 sm:flex-row sm:items-center sm:justify-between" data-share-block>
  <p class="eyebrow-muted">{label}</p>
  <div class="flex flex-wrap gap-2">
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">WhatsApp</a>
    <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">Facebook</a>
    <button type="button" data-copy-share={url} class="btn btn-ghost btn-sm">Copy link</button>
  </div>
  <p data-copy-status class="text-xs text-muted sm:sr-only" aria-live="polite"></p>
</div>

<script is:inline>
  document.querySelectorAll('[data-share-block]').forEach((block) => {
    const button = block.querySelector('[data-copy-share]');
    const status = block.querySelector('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy-share') || window.location.href;
      try {
        await navigator.clipboard.writeText(value);
        if (status) status.textContent = 'Link copied.';
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy link'; }, 1800);
      } catch {
        window.prompt('Copy this link:', value);
      }
    });
  });
</script>
