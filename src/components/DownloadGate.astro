---
interface Props {
  bookId: string;
  bookSlug: string;
  bookTitle: string;
  downloadUrl?: string | null;
  featured?: boolean;
}

const { bookId, bookSlug, bookTitle, downloadUrl, featured = false } = Astro.props;
// A per-instance suffix keeps ids unique when the same book appears twice on a page.
const gateId = `download-gate-${String(bookSlug).replace(/[^a-z0-9-]/gi, '-')}-${Math.random().toString(36).slice(2, 7)}`;
---

{downloadUrl ? (
  <>
    <button
      type="button"
      data-download-gate
      data-book-id={bookId}
      data-book-title={bookTitle}
      data-dialog-id={gateId}
      class:list={[featured ? 'btn btn-primary' : 'link-arrow shrink-0']}
    >
      {featured ? 'Download free' : <>Download free <span aria-hidden="true">→</span></>}
    </button>

    <dialog id={gateId} class="gate-dialog w-[calc(100%-2rem)] max-w-md overflow-hidden border border-line bg-surface p-0 text-ink-2 shadow-2xl">
      <div class="p-7 sm:p-9">
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="eyebrow">A free book</p>
            <h2 class="mt-3 font-display text-[1.9rem] leading-tight">{bookTitle}</h2>
          </div>
          <button type="button" data-dialog-close class="-mr-2 -mt-1 inline-flex h-10 w-10 items-center justify-center rounded-full text-2xl leading-none text-muted hover:bg-ink/5 hover:text-ink" aria-label="Close download form">×</button>
        </div>

        <p class="mt-4 font-serif text-[1.02rem] leading-relaxed text-ink-2">Tell us where to send news of the next book, and your download starts right away.</p>

        <form data-download-form class="mt-6 space-y-4">
          <div>
            <label for={`${gateId}-name`} class="label">Name <span class="font-normal normal-case tracking-normal text-muted">(optional)</span></label>
            <input id={`${gateId}-name`} name="name" type="text" autocomplete="name" maxlength="120" placeholder="Your name" class="field" />
          </div>
          <div>
            <label for={`${gateId}-email`} class="label">Email address</label>
            <input id={`${gateId}-email`} name="email" type="email" required autocomplete="email" maxlength="254" placeholder="you@example.com" class="field" />
          </div>
          <label class="flex items-start gap-3 text-sm leading-6 text-ink-2">
            <input name="consent" type="checkbox" required class="mt-1 h-4 w-4 accent-accent" />
            <span>Send me occasional news about new BLOSSOM books. I can unsubscribe at any time.</span>
          </label>
          <button type="submit" class="btn btn-primary w-full">Start download</button>
          <p data-download-status class="min-h-5 text-sm text-muted" aria-live="polite"></p>
        </form>
      </div>
    </dialog>
    <style is:global>
      .gate-dialog { border-radius: 4px; }
      .gate-dialog::backdrop { background: rgb(20 18 16 / .6); backdrop-filter: blur(3px); }
    </style>
  </>
) : (
  <span class="eyebrow-muted">Digital edition coming soon</span>
)}

<script>
  document.querySelectorAll('[data-download-gate]').forEach((button) => {
    const dialog = document.getElementById(button.getAttribute('data-dialog-id') || '');
    const form = dialog?.querySelector('[data-download-form]');
    const status = dialog?.querySelector('[data-download-status]');
    const close = dialog?.querySelector('[data-dialog-close]');

    if (!dialog || !form || !status) return;

    button.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      const email = formData.get('email');
      const name = formData.get('name');
      const marketingOptIn = formData.get('consent') === 'on';
      const bookId = button.getAttribute('data-book-id');
      if (!email || !bookId || !marketingOptIn) return;

      status.textContent = 'Preparing your download…';
      submit?.setAttribute('disabled', 'true');

      try {
        const response = await fetch('/api/book-downloads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name, marketingOptIn, bookId })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Download could not be prepared.');

        // Same-origin attachment route: this downloads the PDF on phones instead of opening a preview tab.
        const tokenParam = result.downloadToken ? `&token=${encodeURIComponent(result.downloadToken)}` : '';
        window.location.assign(`/api/book-download?bookId=${encodeURIComponent(bookId)}${tokenParam}`);
        dialog.close();
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Download could not be prepared.';
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  });
</script>
