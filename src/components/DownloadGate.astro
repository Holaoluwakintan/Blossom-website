---
interface Props {
  bookId: string;
  bookSlug: string;
  bookTitle: string;
  downloadUrl?: string | null;
  featured?: boolean;
}

const { bookId, bookSlug, bookTitle, downloadUrl, featured = false } = Astro.props;
const gateId = `download-gate-${bookSlug}`;
---

{downloadUrl ? (
  <>
    <button
      type="button"
      data-download-gate
      data-book-id={bookId}
      data-book-title={bookTitle}
      data-dialog-id={gateId}
      class:list={[
        'inline-flex items-center justify-center font-mono uppercase tracking-widest transition-colors',
        featured
          ? 'px-8 py-4 border border-[#E8C868]/50 text-[#E8C868] text-xs font-bold hover:bg-[#E8C868] hover:text-[#02050B]'
          : 'shrink-0 text-[10px] text-slate-300 hover:text-[#E8C868]'
      ]}
    >
      {featured ? 'Download Free' : 'Download →'}
    </button>

    <dialog id={gateId} class="w-[calc(100%-2rem)] max-w-md border border-[#E8C868]/30 bg-[#080D16] p-0 text-[#F6F3EC] shadow-2xl backdrop:bg-[#02050B]/85 backdrop:backdrop-blur-sm">
      <div class="p-7 sm:p-9">
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#E8C868]">Free book access</p>
            <h2 class="mt-3 font-cinzel text-2xl font-bold">Get {bookTitle}</h2>
          </div>
          <button type="button" data-dialog-close class="text-2xl leading-none text-slate-400 hover:text-[#E8C868]" aria-label="Close download form">×</button>
        </div>

        <p class="mt-5 text-sm leading-7 text-slate-400">Get this free and hear when new books drop. Your email helps BLOSSOM stay in touch with future stories.</p>

        <form data-download-form class="mt-6 space-y-4">
          <label for={`${gateId}-name`} class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400">Name <span class="normal-case tracking-normal text-slate-600">(optional)</span></label>
          <input id={`${gateId}-name`} name="name" type="text" autocomplete="name" maxlength="120" placeholder="Your name" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
          <label for={`${gateId}-email`} class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400">Email address</label>
          <input id={`${gateId}-email`} name="email" type="email" required autocomplete="email" maxlength="254" placeholder="you@example.com" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
          <label class="flex items-start gap-3 text-xs leading-5 text-slate-500">
            <input name="consent" type="checkbox" required class="mt-1 accent-[#E8C868]" />
            <span>I agree to receive occasional updates about new BLOSSOM books. I can unsubscribe at any time.</span>
          </label>
          <button type="submit" class="w-full bg-[#E8C868] px-6 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] hover:bg-[#F6F3EC]">Start download</button>
          <p data-download-status class="min-h-5 text-sm text-slate-400" aria-live="polite"></p>
        </form>
      </div>
    </dialog>
  </>
) : (
  <span class="text-[10px] font-mono uppercase tracking-widest text-slate-600">Digital edition coming soon</span>
)}

<script>
  document.querySelectorAll('[data-download-gate]').forEach((button) => {
    const dialog = document.getElementById(button.getAttribute('data-dialog-id') || '');
    const form = dialog?.querySelector('[data-download-form]');
    const status = dialog?.querySelector('[data-download-status]');
    const close = dialog?.querySelector('[data-dialog-close]');

    if (!dialog || !form || !status) return;

    button.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      const email = formData.get('email');
      const name = formData.get('name');
      const marketingOptIn = formData.get('consent') === 'on';
      const bookId = button.getAttribute('data-book-id');
      if (!email || !bookId || !marketingOptIn) return;

      status.textContent = 'Preparing your download…';
      submit?.setAttribute('disabled', 'true');

      try {
        const response = await fetch('/api/book-downloads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name, marketingOptIn, bookId })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Download could not be prepared.');

        // Same-origin attachment route: this downloads the PDF on phones instead of opening a preview tab.
        window.location.assign(`/api/book-download?bookId=${encodeURIComponent(bookId)}`);
        dialog.close();
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Download could not be prepared.';
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  });
</script>
