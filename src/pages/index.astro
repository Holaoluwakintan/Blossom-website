---
import BaseLayout from '../layouts/BaseLayout.astro';
import { optimizedImage } from '../lib/image';
import BookCover from '../components/BookCover.astro';
import ArtFrame from '../components/ArtFrame.astro';
import { getBookCoverUrl } from '../lib/book-downloads';
import { formatDownloadCount } from '../lib/content';
import { supabase } from '../lib/supabase';

export const prerender = false;

const { data: books } = await supabase
  .from('books')
  .select('*')
  .eq('collection', 'blossom');

const featuredBook = books?.find((book) => book.featured === true);
const collectionBooks = (books ?? []).filter((book) => book.id !== featuredBook?.id).slice(0, 4);

const { data: artworks, error: artworksError } = await supabase
  .from('artworks')
  .select('*')
  .limit(6);

const previewArtworks = artworks?.filter((artwork) => artwork.image_url && artwork.slug) ?? [];

let { data: journalPosts, error: journalError } = await supabase
  .from('journal_posts')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false, nullsFirst: false })
  .order('created_at', { ascending: false })
  .limit(3);

if (journalError || !journalPosts || journalPosts.length === 0) {
  const fallback = await supabase
    .from('journal_posts')
    .select('*')
    .eq('status', 'PUBLISHED')
    .order('published_at', { ascending: false, nullsFirst: false })
    .order('created_at', { ascending: false })
    .limit(3);
  if (fallback.data && fallback.data.length > 0) {
    journalPosts = fallback.data;
    journalError = fallback.error;
  }
}

const featuredJournal = journalPosts?.[0];
const journalImage = featuredJournal?.cover_image_url || featuredJournal?.featured_image_url;
---

<BaseLayout
  title="BLOSSOM | The Creative World of Olaoluwa Michael"
  description="Stories and books by Olaoluwa Michael—created to inspire, challenge, and leave readers closer to Jesus."
>
  <div class="overflow-hidden">
    <!-- Hero -->
    <section class="relative">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-full bg-[radial-gradient(60%_55%_at_78%_38%,rgb(var(--accent)/0.10),transparent_70%)]" aria-hidden="true"></div>
      <div class="wrap relative grid items-center gap-12 pb-16 pt-12 sm:pt-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 lg:pb-28 lg:pt-24">
        <div class="max-w-2xl">
          <p class="eyebrow rise">The creative world of Olaoluwa Michael</p>
          <h1 class="display rise rise-1 mt-6 text-[3.4rem] sm:text-[4.6rem] lg:text-[5.6rem]">
            Stories that <em>stay with&nbsp;you.</em>
          </h1>
          <p class="lede rise rise-2 mt-7 max-w-xl">
            BLOSSOM is a home for stories, ideas and imagination, written to inspire,
            awaken faith and leave something meaningful in the heart.
          </p>
          <div class="rise rise-3 mt-9 flex flex-wrap gap-3">
            <a href="/books" class="btn btn-primary">Explore the books</a>
            {featuredBook && <a href={'/books/' + featuredBook.slug} class="btn btn-ghost">Read the featured story</a>}
          </div>
        </div>

        {featuredBook && (
          <a href={'/books/' + featuredBook.slug} class="book-hover rise rise-2 group mx-auto block w-full max-w-[19rem] sm:max-w-[21rem] lg:ml-auto lg:mr-6">
            <BookCover src={getBookCoverUrl(featuredBook)} alt={`${featuredBook.title} book cover`} eager stage sizes="(min-width: 1024px) 336px, 304px" />
            <div class="mt-9 text-center">
              <p class="eyebrow-muted">Featured book</p>
              <p class="mt-2 font-display text-[1.7rem] leading-tight text-ink transition-colors group-hover:text-accent">{featuredBook.title}</p>
              {featuredBook.subtitle && <p class="mt-1 font-display text-lg italic text-ink-2">{featuredBook.subtitle}</p>}
            </div>
          </a>
        )}
      </div>
    </section>

    <!-- Three doors -->
    <section class="band hairline-t hairline-b">
      <div class="wrap py-16 sm:py-24">
        <div class="mx-auto max-w-2xl text-center reveal">
          <p class="eyebrow">There is more to BLOSSOM</p>
          <h2 class="mt-5 font-display text-[2.6rem] leading-tight sm:text-6xl">Read. See. <em class="italic text-accent">Think.</em></h2>
          <p class="lede mx-auto mt-5 max-w-lg">Books to read, images that make invisible truths visible, and reflections for the road ahead.</p>
        </div>
        <div class="mt-14 grid gap-0 sm:mt-16 md:grid-cols-3 md:divide-x md:divide-line">
          {[
            { n: 'I', title: 'Read', text: 'Discover stories created to stay with you.', href: '/books', cta: 'Explore the books' },
            { n: 'II', title: 'See', text: 'Enter a visual world where faith becomes visible.', href: '/imagination', cta: 'Enter Imagination' },
            { n: 'III', title: 'Think', text: 'Bible-based reflections for everyday faith.', href: '/journal', cta: 'Read the Journal' },
          ].map((door, i) => (
            <a href={door.href} class={`group reveal reveal-d${i + 1} block border-t border-line py-9 md:border-t-0 md:px-10 md:py-4 md:first:pl-0 md:last:pr-0`}>
              <p class="font-display text-xl italic text-accent">{door.n}</p>
              <h3 class="mt-3 font-display text-4xl transition-colors group-hover:text-accent">{door.title}</h3>
              <p class="mt-3 max-w-xs font-serif text-[1.08rem] leading-relaxed text-ink-2">{door.text}</p>
              <span class="link-arrow mt-6">{door.cta} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- The collection -->
    <section class="wrap py-20 sm:py-28">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">The collection</p>
          <h2 class="mt-3 font-display text-[2.4rem] leading-tight sm:text-[3.4rem]">Find your next story.</h2>
        </div>
        <a href="/books" class="link-arrow">All books <span aria-hidden="true">→</span></a>
      </div>

      {collectionBooks.length > 0 ? (
        <div class="mt-12 grid grid-cols-2 gap-x-5 gap-y-14 sm:gap-x-10 lg:grid-cols-4">
          {collectionBooks.map((book, i) => (
            <a href={'/books/' + book.slug} class={`book-hover group reveal reveal-d${(i % 3) + 1} block`}>
              <BookCover src={getBookCoverUrl(book)} alt={`${book.title} book cover`} sizes="(min-width: 1024px) 260px, 44vw" />
              <div class="mt-6">
                {book.genre && <p class="eyebrow-muted">{book.genre}</p>}
                <h3 class="mt-2 font-display text-[1.45rem] leading-tight transition-colors group-hover:text-accent sm:text-[1.7rem]">{book.title}</h3>
                {book.subtitle && <p class="mt-1 font-display text-base italic text-ink-2 sm:text-lg">{book.subtitle}</p>}
                <p class="meta mt-3">{formatDownloadCount(book.download_count)}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-center font-serif text-lg italic text-muted">The collection is coming soon.</p>
      )}
    </section>

    <!-- Imagination -->
    <section class="theme-night bg-paper text-ink-2">
      <div class="wrap py-20 sm:py-28">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">Imagination</p>
            <h2 class="mt-3 font-display text-[2.4rem] leading-tight sm:text-[3.4rem]">Faith, in frames.</h2>
          </div>
          <a href="/imagination" class="link-arrow">The full gallery <span aria-hidden="true">→</span></a>
        </div>
        {artworksError ? (
          <p class="mt-12 font-serif text-lg italic text-muted">The artwork preview is temporarily unavailable.</p>
        ) : previewArtworks.length > 0 ? (
          <div class="-mx-5 mt-12 flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto px-5 pb-4 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-8 sm:overflow-visible sm:px-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden">
            {previewArtworks.map((artwork) => (
              <a href={'/imagination/' + artwork.slug} class="mat-hover group block w-[74vw] flex-none snap-start sm:w-auto">
                <ArtFrame src={artwork.image_url} alt={artwork.alt_text || artwork.title} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 74vw" />
                <div class="mt-5">
                  {artwork.category && <p class="eyebrow-muted">{artwork.category}</p>}
                  <h3 class="mt-2 font-display text-2xl leading-tight transition-colors group-hover:text-accent">{artwork.title}</h3>
                  {artwork.caption && <p class="mt-1 line-clamp-2 font-serif italic text-ink-2">{artwork.caption}</p>}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="mt-12 font-serif text-lg italic text-muted">The artwork preview is coming soon.</p>
        )}
      </div>
    </section>

    <!-- About + Journal -->
    <section class="wrap grid gap-16 py-20 sm:py-28 lg:grid-cols-2 lg:gap-20">
      <a href="/about" class="group grid grid-cols-[7.5rem_1fr] items-start gap-6 reveal sm:grid-cols-[10rem_1fr] sm:gap-8">
        <div class="frame">
          <img src="/olaoluwa-michael.jpg" alt="Olaoluwa Michael" width="683" height="1024" loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover grayscale-[15%]" />
        </div>
        <div>
          <p class="eyebrow">About</p>
          <h2 class="mt-3 font-display text-[2rem] leading-tight transition-colors group-hover:text-accent sm:text-[2.5rem]">Meet the mind behind the stories.</h2>
          <p class="mt-4 font-serif text-[1.08rem] leading-relaxed text-ink-2">Olaoluwa Michael, the creative work behind BLOSSOM, and ways to work together.</p>
          <span class="link-arrow mt-6">Read his story <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a href={featuredJournal ? '/journal/' + featuredJournal.slug : '/journal'} class="group block reveal reveal-d1 border-t border-line pt-10 lg:border-l lg:border-t-0 lg:pl-20 lg:pt-0">
        <p class="eyebrow">From the Journal</p>
        {featuredJournal && !journalError ? (
          <>
            <h2 class="mt-3 font-display text-[2rem] leading-tight transition-colors group-hover:text-accent sm:text-[2.5rem]">{featuredJournal.title}</h2>
            <p class="mt-4 line-clamp-4 font-serif text-[1.08rem] leading-relaxed text-ink-2">{featuredJournal.excerpt || 'Bible-based thoughts and encouragement for everyday faith.'}</p>
            <span class="link-arrow mt-6">Read the reflection <span aria-hidden="true">→</span></span>
          </>
        ) : (
          <>
            <h2 class="mt-3 font-display text-[2rem] leading-tight sm:text-[2.5rem]">Reflections for the journey.</h2>
            <p class="mt-4 font-serif text-[1.08rem] leading-relaxed text-ink-2">Bible-based thoughts and encouragement for everyday faith.</p>
            <span class="link-arrow mt-6">Enter the Journal <span aria-hidden="true">→</span></span>
          </>
        )}
      </a>
    </section>

    <!-- Work with Olaoluwa -->
    <section class="band hairline-t hairline-b">
      <div class="wrap grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.3fr_1fr] lg:items-end">
        <div class="reveal">
          <p class="eyebrow">Work with Olaoluwa</p>
          <h2 class="mt-4 text-balance font-display text-[2.3rem] leading-[1.08] sm:text-[3.2rem]">Have an idea worth bringing to life?</h2>
          <p class="lede mt-5 max-w-2xl">Writing, visual storytelling, creative design, AI-assisted concepts and meaningful collaborations for brands, creators, churches and organizations.</p>
        </div>
        <div class="flex flex-col gap-3 reveal reveal-d1 sm:flex-row sm:flex-wrap lg:justify-end">
          <a href="mailto:michaelolaoluwagab@gmail.com?subject=Work%20with%20Olaoluwa" class="btn btn-primary">Start a conversation</a>
          <a href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">WhatsApp Channel</a>
          <a href="https://www.facebook.com/share/1DTMt74HuT/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Facebook</a>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="wrap py-24 text-center sm:py-32">
      <div class="reveal">
        <p class="fleuron" aria-hidden="true"><span class="font-display text-2xl">❦</span></p>
        <h2 class="mx-auto mt-8 max-w-3xl text-balance font-display text-[2.4rem] leading-[1.1] sm:text-[3.8rem]">Many stories leave something behind.</h2>
        <p class="mt-4 font-display text-[1.7rem] italic text-accent sm:text-[2.4rem]">Let these leave you closer to Jesus.</p>
        <a href="/books" class="btn btn-primary mt-10">Begin with a book</a>
      </div>
    </section>
  </div>
</BaseLayout>
