
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';


export const prerender = false;

const { data: books, error: booksError } = await supabase
  .from('books')
  .select('*')
  .order('created_at', { ascending: false });

const allBooks = books ?? [];
const featuredBook = allBooks.find((book) => book.featured === true) ?? allBooks[0];
const collectionBooks = featuredBook
  ? allBooks.filter((book) => book.id !== featuredBook.id)
  : allBooks;

const formatPrice = (book) => {
  const price = Number(book.price_ngn ?? 0);
  return price > 0 ? `₦${price.toLocaleString('en-NG')}` : 'Free';
};
---

<BaseLayout
  title="Books | BLOSSOM"
  description="Explore the books and written works of Olaoluwa Michael."
>
  <main class="min-h-screen bg-[#02050B] text-[#F6F3EC]">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(232,200,104,0.12),transparent_45%)]"></div>
      <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-24 text-center lg:pb-28">
        <p class="text-xs font-mono uppercase tracking-[0.4em] text-[#E8C868]">BLOSSOM BOOKS</p>
        <h1 class="mt-6 font-cinzel text-5xl font-bold leading-tight sm:text-7xl">
          Stories that
          <br />
          <span class="font-editorial font-normal italic text-[#E8C868]">stay with you.</span>
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-base leading-8 text-slate-400 sm:text-lg">
          Explore stories and written works created to entertain, challenge, inspire and leave something meaningful behind.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
      {booksError && (
        <div class="border border-red-500/20 bg-[#080D16] p-10 text-center">
          <p class="font-mono text-xs uppercase tracking-widest text-red-400">Books could not be loaded</p>
          <p class="mt-3 text-sm text-slate-500">{booksError.message}</p>
        </div>
      )}

      {!booksError && featuredBook && (
        <div class="mb-20 grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <a href={`/books/${featuredBook.slug}`} class="group mx-auto block w-full max-w-md">
            <div class="overflow-hidden border border-white/10 bg-[#080D16]">
              <img
                src={featuredBook.cover_image_url}
                alt={`${featuredBook.title} book cover`}
                class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
          </a>

          <div>
            <p class="mb-5 text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">Featured Book</p>
            <h2 class="font-cinzel text-4xl font-bold leading-tight sm:text-5xl">{featuredBook.title}</h2>
            {featuredBook.subtitle && <p class="mt-4 font-editorial text-xl italic text-[#E8C868]">{featuredBook.subtitle}</p>}
            <p class="mt-5 text-sm font-mono text-slate-400">
              By {featuredBook.author}{featuredBook.publication_year && <> • {featuredBook.publication_year}</>}
            </p>
            {featuredBook.synopsis && <p class="mt-7 text-lg leading-8 text-slate-300">{featuredBook.synopsis}</p>}
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <span class="font-mono text-sm uppercase tracking-widest text-[#E8C868]">{formatPrice(featuredBook)}</span>
              <a href={`/books/${featuredBook.slug}`} class="inline-flex bg-[#E8C868] px-8 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] transition-colors hover:bg-[#F6F3EC]">
                Explore Book →
              </a>
            </div>
          </div>
        </div>
      )}

      <div class="border-t border-white/10 pt-16">
        <div class="mb-11">
          <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#E8C868]">The Collection</p>
          <h2 class="mt-4 font-cinzel text-3xl font-bold sm:text-4xl">More stories to discover.</h2>
        </div>

        {!booksError && collectionBooks.length > 0 ? (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {collectionBooks.map((book) => (
              <a href={`/books/${book.slug}`} class="group block">
                <div class="overflow-hidden border border-white/10 bg-[#080D16]">
                  <img
                    src={book.cover_image_url}
                    alt={`${book.title} book cover`}
                    loading="lazy"
                    class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
                <div class="pt-5">
                  {book.genre && <p class="text-[9px] font-mono uppercase tracking-[0.22em] text-slate-500">{book.genre}</p>}
                  <h3 class="mt-2 font-cinzel text-2xl font-bold transition-colors group-hover:text-[#E8C868]">{book.title}</h3>
                  {book.subtitle && <p class="mt-1 font-editorial italic text-[#E8C868]">{book.subtitle}</p>}
                  <p class="mt-3 font-mono text-sm text-slate-400">{formatPrice(book)}</p>
                </div>
              </a>
            ))}
          </div>
        ) : !booksError ? (
          <div class="border border-white/10 bg-[#080D16] p-10 text-center">
            <p class="font-mono text-sm text-slate-500">More stories are coming soon.</p>
          </div>
        ) : null}
      </div>
    </section>
  </main>
</BaseLayout>
