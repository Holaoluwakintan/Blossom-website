---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
const reference = Astro.url.searchParams.get('reference') || '';
---

<BaseLayout
  title="Payment confirmation | BLOSSOM"
  description="Confirm your BLOSSOM book payment and access your digital download."
>
  <div class="wrap-narrow py-20 sm:py-28">
    <section class="card mx-auto max-w-xl p-8 text-center sm:p-14">
      <p class="eyebrow">BLOSSOM Books</p>
      <h1 class="mt-5 font-display text-[2.6rem] leading-tight">Confirming your payment</h1>
      <p id="payment-message" class="mt-5 font-serif text-lg leading-relaxed text-ink-2">Please wait a moment while we verify your Paystack payment.</p>
      <div id="download-area" class="mt-9"></div>
      <a href="/books" class="link-arrow mt-10"><span aria-hidden="true">←</span> Return to books</a>
    </section>
  </div>

  <script is:inline define:vars={{ reference }}>
    const message = document.getElementById('payment-message');
    const area = document.getElementById('download-area');

    const showError = (text) => {
      if (message) {
        message.textContent = text;
        message.className = 'mt-5 font-serif text-lg leading-relaxed text-wine';
      }
    };

    if (!reference) {
      showError('No payment reference was found. Please return to the Books page and try again.');
    } else {
      fetch('/api/payments/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reference })
      })
        .then(async (response) => {
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.error || 'Payment could not be verified.');
          if (message) message.textContent = `${result.title} is ready to download.`;
          if (area) {
            area.innerHTML = `<a href="${result.download_url}" class="btn btn-primary" download>Download your book</a><p class="meta mt-4">This private link expires in one hour. Save the file after downloading.</p>`;
          }
        })
        .catch((error) => showError(error.message));
    }
  </script>
</BaseLayout>
