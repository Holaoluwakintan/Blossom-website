---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';


export const prerender = false;
const slug = Astro.params.slug?.trim();
const { data: book } = slug
  ? await supabase.from('books').select('*').eq('slug', slug).maybeSingle()
  : { data: null };

if (!book) return Astro.redirect('/books');

---

<BaseLayout title={`Download ${book.title} | BLOSSOM`} description={`Download ${book.title} free from BLOSSOM.`}>
  <div class="wrap-narrow py-20 text-center sm:py-28">
    <p class="eyebrow rise">A free book</p>
    <h1 class="display rise rise-1 mt-6 text-[2.8rem] sm:text-[4.2rem]">{book.title}</h1>
    <p class="lede rise rise-2 mx-auto mt-6 max-w-xl">Open the book page, enter your email once, and the free digital edition downloads straight away.</p>
    <div class="rise rise-3 mt-10 flex flex-wrap justify-center gap-3">
      <a href={`/books/${book.slug}`} class="btn btn-primary">Open the book page</a>
      <a href="/books" class="btn btn-ghost">Browse all books</a>
    </div>
    <div class="mt-16 grid gap-px overflow-hidden border border-line bg-line text-left sm:grid-cols-2">
      <a href="/books" class="group bg-surface p-8"><p class="eyebrow">Keep reading</p><p class="mt-3 font-display text-2xl transition-colors group-hover:text-accent">Find another book →</p></a>
      <a href="/journal" class="group bg-surface p-8"><p class="eyebrow">Stay close</p><p class="mt-3 font-display text-2xl transition-colors group-hover:text-accent">Read the Journal →</p></a>
    </div>
  </div>

</BaseLayout>
