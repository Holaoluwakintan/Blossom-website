---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;

const { data: book, error } = await supabase
  .from('books')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if (error || !book) {
  throw new Error(
    `Book not found. Slug: ${slug}. Supabase error: ${error?.message ?? 'No book returned'}`
  );
}

const { data: reviews, error: reviewsError } = await supabase
  .from('book_reviews')
  .select('id, rating, review_title, review_body, reviewer_name, created_at')
  .eq('book_id', book.id)
  .eq('status', 'PUBLISHED')
  .order('created_at', { ascending: false });

const publishedReviews = reviews ?? [];
const averageRating = publishedReviews.length
  ? publishedReviews.reduce((sum, review) => sum + Number(review.rating), 0) / publishedReviews.length
  : 0;
const roundedAverageRating = averageRating ? averageRating.toFixed(1) : '0.0';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-NG', { dateStyle: 'medium' }).format(new Date(value));

const downloadUrl = [book.download_url, book.file_url, book.public_url]
  .find((value) => typeof value === 'string' && value.trim())
  ?.trim() ?? null;

// Balm of Gilead remains a free download when it has a download URL and no price.
// BLOSSOM books are now free to access. Support is optional and shown below.
const isFree = true;

const formatNaira = (price: number | string | null) =>
  `₦${Number(price).toLocaleString('en-NG')}`;

const priceLabel = 'Free';


---

<BaseLayout
  title={`${book.title} | BLOSSOM`}
  description={book.synopsis ?? book.description ?? `Explore ${book.title} by ${book.author ?? 'Olaoluwa Michael'}.`}
  image={book.cover_image_url}
  canonical={`https://olaoluwamichael.vercel.app/books/${book.slug}`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: book.title,
    author: { '@type': 'Person', name: book.author ?? 'Olaoluwa Michael' },
    image: book.cover_image_url,
    description: book.synopsis ?? book.description,
    genre: book.genre,
    datePublished: book.publication_year ? String(book.publication_year) : undefined,
    url: `https://olaoluwamichael.vercel.app/books/${book.slug}`,
    isAccessibleForFree: isFree,
    offers: !isFree && book.price_ngn ? {
      '@type': 'Offer',
      price: Number(book.price_ngn),
      priceCurrency: 'NGN',
      availability: 'https://schema.org/InStock',
      url: `https://olaoluwamichael.vercel.app/books/${book.slug}`,
    } : undefined,
  }}
>
  <main class="min-h-screen bg-[#02050B] text-[#F6F3EC]">

    <!-- TOP NAVIGATION -->
    <section class="max-w-7xl mx-auto px-6 pt-8 lg:pt-12">
      <a
        href="/books"
        class="inline-flex items-center gap-3 text-xs font-mono uppercase tracking-[0.2em] text-slate-400 hover:text-[#E8C868] transition-colors"
      >
        <span class="text-lg">←</span>
        Back to Books
      </a>
    </section>


    <!-- BOOK HERO -->
    <section class="max-w-7xl mx-auto px-6 py-12 lg:py-20">

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- BOOK COVER -->
        <div class="flex justify-center">

          <div class="w-full max-w-md relative">

            <div class="absolute -inset-4 bg-[#E8C868]/5 blur-3xl"></div>

            <img
              src={book.cover_image_url}
              alt={`${book.title} book cover`}
              class="relative w-full rounded-sm shadow-2xl"
            />

          </div>

        </div>


        <!-- BOOK INFORMATION -->
        <div>

          {book.genre && (
            <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868] mb-5">
              {book.genre}
            </p>
          )}

          <h1 class="font-cinzel text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-4">
            {book.title}
          </h1>

          {book.subtitle && (
            <p class="font-editorial italic text-xl sm:text-2xl text-[#E8C868] mb-6">
              {book.subtitle}
            </p>
          )}

          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-400 font-mono mb-8">
            {book.author && <span>By {book.author}</span>}
            {book.publication_year && <span>{book.publication_year}</span>}
            {book.format && <span>{book.format}</span>}
          </div>


          <!-- SYNOPSIS -->
          {book.synopsis && (
            <div class="mb-8">

              <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-[#E8C868] mb-3">
                About the Book
              </h2>

              <p class="text-slate-300 text-lg leading-relaxed">
                {book.synopsis}
              </p>

            </div>
          )}


          <!-- ACTION AREA -->
          <div class="flex flex-wrap gap-4 mb-8">

            {downloadUrl ? (
              <a
                href={downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-all duration-300"
              >
                Download Free E-Book
              </a>
            ) : (
              <p class="border border-[#E8C868]/30 px-6 py-4 text-sm text-[#E8C868]">
                Free access · Digital edition coming soon
              </p>
            )}

            {!isFree && (
              <>
                <button
                  type="button"
                  id="paystack-button"
                  data-book-id={book.id}
                  class="inline-flex items-center justify-center px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-all duration-300"
                >
                  Buy with Paystack
                </button>
                <a
                  href={whatsappOrderUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-all duration-300"
                >
                  Order on WhatsApp
                </a>

                <a
                  href={emailOrderUrl}
                  class="inline-flex items-center justify-center px-8 py-4 border border-[#E8C868]/50 text-[#E8C868] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#E8C868] hover:text-[#02050B] transition-colors"
                >
                  Order by Email
                </a>
              </>
            )}

          </div>

          {!isFree && (
            <div id="paystack-panel" class="hidden fixed inset-0 z-50 items-center justify-center bg-[#02050B]/85 px-6 backdrop-blur-sm">
              <div class="w-full max-w-md border border-[#E8C868]/30 bg-[#080D16] p-7 shadow-2xl">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#E8C868]">Secure checkout</p>
                    <h2 class="mt-3 font-cinzel text-2xl font-bold">Buy this book</h2>
                  </div>
                  <button type="button" id="paystack-close" class="text-2xl text-slate-400 hover:text-[#E8C868]" aria-label="Close checkout">×</button>
                </div>
                <p class="mt-5 text-sm leading-7 text-slate-400">Enter your email. Paystack will open a secure payment page, then return you here to download your book.</p>
                <form id="paystack-form" class="mt-6 space-y-4">
                  <label class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400" for="customer-email">Email address</label>
                  <input id="customer-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
                  <button type="submit" class="w-full bg-[#E8C868] px-6 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] hover:bg-[#F6F3EC]">Continue to payment</button>
                  <p id="paystack-error" class="hidden text-sm text-red-300"></p>
                </form>
              </div>
            </div>
          )}

          {downloadUrl && isFree && (
            <p class="text-xs text-slate-500 font-mono">
              Free digital edition • PDF
            </p>
          )}

          <div class="border-t border-white/10 pt-5">
            <p class="text-[9px] font-mono uppercase tracking-[0.2em] text-slate-500 mb-1">
              Access
            </p>
            <p class="font-cinzel text-xl sm:text-2xl font-bold text-[#E8C868]">
              Free digital edition
            </p>
          </div>

        </div>

      </div>


      <!-- FULL DESCRIPTION -->
      {book.description && (
        <section class="max-w-4xl mx-auto mt-20 pt-12 border-t border-white/10">

          <p class="text-xs font-mono uppercase tracking-[0.25em] text-[#E8C868] mb-5">
            The Story
          </p>

          <h2 class="font-cinzel text-2xl sm:text-3xl font-bold mb-6">
            About This Book
          </h2>

          <div class="text-slate-300 leading-8 text-base sm:text-lg whitespace-pre-line">
            {book.description}
          </div>

        </section>
      )}


      <!-- REVIEWS -->
      <section id="book-reviews" class="max-w-4xl mx-auto mt-20 pt-12 border-t border-white/10">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-mono uppercase tracking-[0.25em] text-[#E8C868] mb-5">Reader response</p>
            <h2 class="font-cinzel text-2xl sm:text-3xl font-bold">Reviews for {book.title}</h2>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-3xl font-cinzel font-bold text-[#E8C868]">{roundedAverageRating} <span class="text-xl">★</span></p>
            <p class="text-xs font-mono uppercase tracking-widest text-slate-500">{publishedReviews.length} {publishedReviews.length === 1 ? 'review' : 'reviews'}</p>
          </div>
        </div>

        {reviewsError && <p class="mt-8 text-sm text-red-300">Reviews could not be loaded right now.</p>}
        {!reviewsError && publishedReviews.length === 0 && <p class="mt-8 leading-8 text-slate-400">No reviews yet. Be the first reader to share a thoughtful response.</p>}
        <div class="mt-8 space-y-5">
          {publishedReviews.map((review) => (
            <article class="border border-white/10 bg-[#080D16] p-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="font-mono text-xs uppercase tracking-widest text-[#E8C868]">{review.reviewer_name}</p>
                <p class="text-[#E8C868]" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(Number(review.rating))}{'☆'.repeat(5 - Number(review.rating))}</p>
              </div>
              {review.review_title && <h3 class="mt-4 font-cinzel text-lg font-bold text-[#F6F3EC]">{review.review_title}</h3>}
              <p class="mt-3 leading-8 text-slate-300">{review.review_body}</p>
              <p class="mt-4 font-mono text-[10px] uppercase tracking-widest text-slate-600">{formatDate(review.created_at)}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 border border-[#E8C868]/20 bg-[#080D16] p-7 sm:p-9">
          <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#E8C868]">Share your thoughts</p>
          <h3 class="mt-3 font-cinzel text-2xl font-bold">Leave a review.</h3>
          <p class="mt-4 leading-7 text-slate-400">Your review will appear immediately. Please keep it honest, respectful, and useful to future readers.</p>
          <form id="book-review-form" class="mt-7 space-y-5">
            <input type="hidden" name="book_id" value={book.id} />
            <input type="text" name="website_url" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div>
              <label for="review-rating" class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400">Rating</label>
              <select id="review-rating" name="rating" required class="mt-2 w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]">
                <option value="">Choose a rating</option>
                <option value="5">5 — Excellent</option>
                <option value="4">4 — Very good</option>
                <option value="3">3 — Good</option>
                <option value="2">2 — Needs improvement</option>
                <option value="1">1 — Not for me</option>
              </select>
            </div>
            <input name="reviewer_name" required maxlength="80" placeholder="Your name" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
            <input name="reviewer_email" type="email" maxlength="160" placeholder="Email (kept private, optional)" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
            <input name="review_title" maxlength="120" placeholder="Review headline (optional)" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]" />
            <textarea name="review_body" required maxlength="2000" rows="6" placeholder="What did you think about the book?" class="w-full border border-white/15 bg-[#02050B] px-4 py-3 text-[#F6F3EC] outline-none focus:border-[#E8C868]"></textarea>
            <button type="submit" class="bg-[#E8C868] px-7 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] hover:bg-[#F6F3EC]">Publish review →</button>
            <p id="book-review-status" class="text-sm text-slate-400" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <!-- SUPPORT THE PROJECT -->
      <section class="max-w-4xl mx-auto mt-20 border border-[#E8C868]/25 bg-[#080D16] p-7 sm:p-10">
        <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#E8C868]">Support the project</p>
        <h2 class="mt-4 font-cinzel text-2xl sm:text-3xl font-bold">Enjoyed this book?</h2>
        <p class="mt-4 max-w-2xl text-slate-400 leading-8">
          These books are free to read and download. If you would like to support the stories,
          artwork, and faith-based creative work behind BLOSSOM, you can give by bank transfer.
        </p>
        <button
          type="button"
          id="support-project-button"
          aria-expanded="false"
          aria-controls="support-project-details"
          class="mt-7 inline-flex items-center justify-center bg-[#E8C868] px-7 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] hover:bg-[#F6F3EC] transition-colors"
        >
          If you want to support my projects →
        </button>
        <div id="support-project-details" hidden class="mt-7 border-t border-white/10 pt-7">
          <p class="text-xs font-mono uppercase tracking-[0.2em] text-slate-500">Bank transfer</p>
          <dl class="mt-5 grid gap-4 sm:grid-cols-3">
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Bank</dt>
              <dd class="mt-1 text-lg text-[#F6F3EC]">FCMB</dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Account number</dt>
              <dd class="mt-1 text-lg font-mono text-[#F6F3EC]">6683003010</dd>
            </div>
            <div>
              <dt class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Account name</dt>
              <dd class="mt-1 text-lg text-[#F6F3EC]">Olaoluwa Michael</dd>
            </div>
          </dl>
          <p class="mt-7 font-editorial text-xl italic text-[#E8C868]">God bless you as you give. Thank you.</p>
          <div class="mt-6 flex flex-wrap gap-4">
            <button type="button" id="copy-support-account" class="border border-[#E8C868]/50 px-5 py-3 font-mono text-[10px] font-bold uppercase tracking-widest text-[#E8C868] hover:bg-[#E8C868] hover:text-[#02050B] transition-colors">Copy account number</button>
          </div>
          <p id="support-copy-status" class="mt-3 text-xs text-slate-500" aria-live="polite"></p>
        </div>
      </section>

      <!-- BACK TO BOOKS -->
      <div class="max-w-4xl mx-auto mt-16 pt-8 border-t border-white/10">

        <a
          href="/books"
          class="inline-flex items-center gap-3 text-xs font-mono uppercase tracking-[0.2em] text-slate-400 hover:text-[#E8C868] transition-colors"
        >
          <span>←</span>
          Explore All Books
        </a>

      </div>

    </section>

  </main>

  {!isFree && (
    <script is:inline>
      const payButton = document.getElementById('paystack-button');
      const panel = document.getElementById('paystack-panel');
      const closeButton = document.getElementById('paystack-close');
      const form = document.getElementById('paystack-form');
      const errorBox = document.getElementById('paystack-error');
      const bookId = payButton?.getAttribute('data-book-id');

      const closePaystack = () => panel?.classList.replace('flex', 'hidden');
      payButton?.addEventListener('click', () => panel?.classList.replace('hidden', 'flex'));
      closeButton?.addEventListener('click', closePaystack);
      panel?.addEventListener('click', (event) => { if (event.target === panel) closePaystack(); });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = new FormData(form).get('email');
        const submit = form.querySelector('button[type="submit"]');
        if (submit) submit.textContent = 'Opening secure checkout…';
        errorBox?.classList.add('hidden');

        try {
          const response = await fetch('/api/payments/initialize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookId, email })
          });
          const result = await response.json();
          if (!response.ok || !result.authorization_url) throw new Error(result.error || 'Unable to start payment.');
          window.location.href = result.authorization_url;
        } catch (error) {
          if (errorBox) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); }
          if (submit) submit.textContent = 'Continue to payment';
        }
      });
    </script>
  )}
  <script is:inline>
    const supportButton = document.getElementById('support-project-button');
    const supportDetails = document.getElementById('support-project-details');
    const copySupportAccount = document.getElementById('copy-support-account');
    const supportCopyStatus = document.getElementById('support-copy-status');

    supportButton?.addEventListener('click', () => {
      if (!supportDetails) return;
      const opening = supportDetails.hidden;
      supportDetails.hidden = !opening;
      supportButton.setAttribute('aria-expanded', String(opening));
      supportButton.textContent = opening ? 'Hide support details' : 'If you want to support my projects →';
    });

    copySupportAccount?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('6683003010');
        if (supportCopyStatus) supportCopyStatus.textContent = 'Account number copied.';
      } catch {
        if (supportCopyStatus) supportCopyStatus.textContent = 'Account number: 6683003010';
      }
    });

    const reviewForm = document.getElementById('book-review-form');
    const reviewStatus = document.getElementById('book-review-status');

    reviewForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!reviewForm || !reviewStatus) return;
      reviewStatus.textContent = 'Publishing your review…';
      const submitButton = reviewForm.querySelector('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch('/api/book-reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(reviewForm).entries())),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Review could not be published.');
        reviewForm.reset();
        reviewStatus.textContent = 'Thank you. Your review is now visible.';
        window.setTimeout(() => window.location.reload(), 700);
      } catch (error) {
        reviewStatus.textContent = error instanceof Error ? error.message : 'Review could not be published.';
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
