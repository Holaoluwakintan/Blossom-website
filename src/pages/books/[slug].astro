---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/BookCover.astro';
import ShareActions from '../../components/ShareActions.astro';
import DownloadGate from '../../components/DownloadGate.astro';
import BookOrderLink from '../../components/BookOrderLink.astro';
import { getBookCoverUrl, getBookDownloadUrl } from '../../lib/book-downloads';
import { supabase, supabaseServer } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;

let { data: book, error } = await supabaseServer
  .from('books')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if ((error || !book) && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('books')
    .select('*')
    .eq('slug', slug)
    .maybeSingle();
  if (!fallback.error && fallback.data) {
    book = fallback.data;
    error = null;
  }
}

if (error || !book) {
  return Astro.redirect('/books');
}

let { data: reviews, error: reviewsError } = await supabaseServer
  .from('book_reviews')
  .select('id, rating, review_title, review_body, reviewer_name, created_at')
  .eq('book_id', book.id)
  .or('status.eq.PUBLISHED,status.is.null')
  .order('created_at', { ascending: false });

if (reviewsError && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('book_reviews')
    .select('id, rating, review_title, review_body, reviewer_name, created_at')
    .eq('book_id', book.id)
    .or('status.eq.PUBLISHED,status.is.null')
    .order('created_at', { ascending: false });
  if (!fallback.error) {
    reviews = fallback.data;
    reviewsError = null;
  }
}

const publishedReviews = reviews ?? [];
const averageRating = publishedReviews.length
  ? publishedReviews.reduce((sum, review) => sum + Number(review.rating), 0) / publishedReviews.length
  : 0;
const roundedAverageRating = averageRating ? averageRating.toFixed(1) : '0.0';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-NG', { dateStyle: 'medium' }).format(new Date(value));

const downloadUrl = getBookDownloadUrl(book);
const isOtherAuthor = book.collection === 'other-authors';
const isPaid = isOtherAuthor && (book.access_type === 'paid' || Boolean(book.purchase_url));
const isFree = !isPaid;
const purchaseUrl = typeof book.purchase_url === 'string' ? book.purchase_url.trim() : '';

const formatNaira = (price: number | string | null) =>
  `₦${Number(price).toLocaleString('en-NG')}`;

const priceLabel = 'Free';
const coverUrl = getBookCoverUrl(book);
const pageUrl = `https://olaoluwamichael.vercel.app/books/${encodeURIComponent(book.slug)}`;
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(Math.max(0, 5 - n));

const whatsappOrderText = encodeURIComponent(`Hello Olaoluwa, I would like to order the book: "${book.title}".`);
const whatsappOrderUrl = `https://wa.me/2348000000000?text=${whatsappOrderText}`;
const emailOrderUrl = `mailto:michaelolaoluwagab@gmail.com?subject=${encodeURIComponent(`Book Order: ${book.title}`)}&body=${encodeURIComponent(`Hello Olaoluwa,\n\nI would like to order "${book.title}". Please send me details on how to receive a copy.\n\nThank you!`)}`;
---

<BaseLayout
  title={`${book.title} | BLOSSOM`}
  description={book.synopsis ?? book.description ?? `Explore ${book.title} by ${book.author ?? 'Olaoluwa Michael'}.`}
  image={coverUrl ?? book.cover_image_url}
  canonical={`https://olaoluwamichael.vercel.app/books/${book.slug}`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: book.title,
    author: { '@type': 'Person', name: book.author ?? 'Olaoluwa Michael' },
    image: coverUrl ?? book.cover_image_url,
    description: book.synopsis ?? book.description,
    genre: book.genre,
    datePublished: book.publication_year ? String(book.publication_year) : undefined,
    url: `https://olaoluwamichael.vercel.app/books/${book.slug}`,
    isAccessibleForFree: isFree,
    offers: !isFree && book.price_ngn ? {
      '@type': 'Offer',
      price: Number(book.price_ngn),
      priceCurrency: 'NGN',
      availability: 'https://schema.org/InStock',
      url: `https://olaoluwamichael.vercel.app/books/${book.slug}`,
    } : undefined,
  }}
>
  <div>
    <nav class="wrap pt-6 sm:pt-10" aria-label="Breadcrumb">
      <a href={isOtherAuthor ? '/books/other-authors' : '/books'} class="link-arrow text-muted"><span aria-hidden="true">←</span> {isOtherAuthor ? 'Other authors' : 'All books'}</a>
    </nav>

    <!-- Book hero -->
    <section class="wrap grid items-start gap-14 pb-16 pt-10 sm:pt-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24 lg:pb-24">
      <div class="lg:sticky lg:top-28">
        <div class="book-hover mx-auto w-full max-w-[16.5rem] sm:max-w-[21rem]">
          <BookCover src={coverUrl} alt={`${book.title} book cover`} eager stage sizes="(min-width: 640px) 336px, 264px" />
        </div>
      </div>

      <div class="rise">
        {book.genre && <p class="eyebrow">{book.genre}</p>}
        <h1 class="display mt-4 text-[2.9rem] sm:text-[4.2rem] lg:text-[4.6rem]">{book.title}</h1>
        {book.subtitle && <p class="mt-3 font-display text-[1.6rem] italic leading-snug text-ink-2 sm:text-[1.9rem]">{book.subtitle}</p>}

        <dl class="mt-8 grid grid-cols-2 gap-y-5 border-y border-line py-5 sm:grid-cols-4">
          {book.author && <div><dt class="eyebrow-muted">Author</dt><dd class="mt-1.5 font-display text-lg text-ink">{book.author}</dd></div>}
          {book.publication_year && <div><dt class="eyebrow-muted">Published</dt><dd class="mt-1.5 font-display text-lg text-ink">{book.publication_year}</dd></div>}
          {book.format && <div><dt class="eyebrow-muted">Format</dt><dd class="mt-1.5 font-display text-lg text-ink">{book.format}</dd></div>}
          <div><dt class="eyebrow-muted">Access</dt><dd class="mt-1.5 font-display text-lg text-accent">{isPaid ? 'Paid edition' : 'Free'}</dd></div>
        </dl>

        {book.synopsis && (
          <div class="mt-8">
            <h2 class="sr-only">About the book</h2>
            <p class="whitespace-pre-line font-serif text-[1.18rem] leading-[1.75] text-ink">{book.synopsis}</p>
          </div>
        )}

        <!-- Actions -->
        <div class="mt-10 flex flex-wrap gap-3">
          {isPaid && purchaseUrl ? (
            <a href={purchaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Buy the book <span aria-hidden="true">↗</span></a>
          ) : isPaid ? (
            <span class="btn btn-ghost pointer-events-none opacity-60">Seller link coming soon</span>
          ) : book.slug === 'crack-the-algorithm' ? (
            <BookOrderLink bookTitle={book.title} featured />
          ) : (
            <DownloadGate
              bookId={book.id}
              bookSlug={book.slug}
              bookTitle={book.title}
              downloadUrl={downloadUrl}
              featured
            />
          )}

          {!isFree && !isOtherAuthor && (
            <>
              <button type="button" id="paystack-button" data-book-id={book.id} class="btn btn-gold">Buy with Paystack</button>
              <a href={whatsappOrderUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Order on WhatsApp</a>
              <a href={emailOrderUrl} class="btn btn-ghost">Order by email</a>
            </>
          )}
        </div>

        <p class="meta mt-4">
          {isPaid ? 'Paid edition · secure checkout with the seller'
            : book.slug === 'crack-the-algorithm' ? 'Order your copy by email; Olaoluwa replies with the price and payment details'
            : downloadUrl ? 'Free digital edition · PDF' : ''}
        </p>

        {!isFree && !isOtherAuthor && (
          <div id="paystack-panel" class="hidden fixed inset-0 z-50 items-center justify-center bg-[rgb(20_18_16/0.6)] px-5 backdrop-blur-sm">
            <div class="w-full max-w-md border border-line bg-surface p-7 shadow-2xl sm:p-9">
              <div class="flex items-start justify-between gap-6">
                <div>
                  <p class="eyebrow">Secure checkout</p>
                  <h2 class="mt-3 font-display text-[1.9rem] leading-tight">Buy this book</h2>
                </div>
                <button type="button" id="paystack-close" class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-full text-2xl text-muted hover:bg-ink/5 hover:text-ink" aria-label="Close checkout">×</button>
              </div>
              <p class="mt-4 font-serif text-[1.02rem] leading-relaxed text-ink-2">Enter your email. Paystack opens a secure payment page, then brings you back here to download your book.</p>
              <form id="paystack-form" class="mt-6 space-y-4">
                <label class="label" for="customer-email">Email address</label>
                <input id="customer-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field" />
                <button type="submit" class="btn btn-primary w-full">Continue to payment</button>
                <p id="paystack-error" class="hidden text-sm text-wine"></p>
              </form>
            </div>
          </div>
        )}

        <ShareActions title={book.title} url={pageUrl} label="Share this book" />
      </div>
    </section>

    <!-- The story -->
    {book.description && (
      <section class="band hairline-t hairline-b">
        <div class="wrap-narrow py-16 sm:py-24">
          <p class="eyebrow">The story</p>
          <h2 class="mt-4 font-display text-[2.3rem] leading-tight sm:text-[3rem]">About this book</h2>
          <div class="prose-literary drop-cap mt-8 whitespace-pre-line"><p>{book.description}</p></div>
        </div>
      </section>
    )}

    <!-- Reviews -->
    <section id="book-reviews" class="wrap-narrow scroll-mt-24 py-20 sm:py-24">
      <div class="flex flex-col gap-6 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Reader response</p>
          <h2 class="mt-3 font-display text-[2.3rem] leading-tight sm:text-[2.8rem]">What readers are saying</h2>
        </div>
        <div class="sm:text-right">
          <p class="font-display text-[2.6rem] leading-none text-ink">{roundedAverageRating}<span class="ml-1 text-2xl text-accent">★</span></p>
          <p class="meta mt-1">{publishedReviews.length} {publishedReviews.length === 1 ? 'review' : 'reviews'}</p>
        </div>
      </div>

      {reviewsError && <p class="mt-8 text-sm text-wine">Reviews could not be loaded right now.</p>}
      {!reviewsError && publishedReviews.length === 0 && <p class="mt-8 font-serif text-lg italic text-muted">No reviews yet. Be the first reader to share a thoughtful response.</p>}

      <div class="divide-y divide-line">
        {publishedReviews.map((review) => (
          <article class="py-8">
            <p class="tracking-[0.2em] text-accent" aria-label={`${review.rating} out of 5 stars`}>{stars(Number(review.rating))}</p>
            {review.review_title && <h3 class="mt-3 font-display text-2xl leading-snug">{review.review_title}</h3>}
            <p class="mt-3 font-serif text-[1.1rem] leading-relaxed text-ink">“{review.review_body}”</p>
            <p class="meta mt-4"><span class="font-semibold text-ink-2">{review.reviewer_name}</span> · {formatDate(review.created_at)}</p>
          </article>
        ))}
      </div>

      <div class="card mt-10 p-6 sm:p-10">
        <p class="eyebrow">Share your thoughts</p>
        <h3 class="mt-3 font-display text-[2rem] leading-tight">Leave a review</h3>
        <p class="mt-3 font-serif text-[1.02rem] leading-relaxed text-ink-2">Your review appears straight away. Please keep it honest, kind and useful to the next reader.</p>
        <form id="book-review-form" class="mt-8 grid gap-5 sm:grid-cols-2">
          <input type="hidden" name="book_id" value={book.id} />
          <input type="text" name="website_url" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div>
            <label for="review-rating" class="label">Rating</label>
            <select id="review-rating" name="rating" required class="field">
              <option value="">Choose a rating</option>
              <option value="5">5 — Excellent</option>
              <option value="4">4 — Very good</option>
              <option value="3">3 — Good</option>
              <option value="2">2 — Needs improvement</option>
              <option value="1">1 — Not for me</option>
            </select>
          </div>
          <div>
            <label for="review-author-name" class="label">Your name</label>
            <input id="review-author-name" name="reviewer_name" required maxlength="80" placeholder="Your name" class="field" />
          </div>
          <div>
            <label for="review-author-email" class="label">Email <span class="font-normal normal-case tracking-normal text-muted">(optional, kept private)</span></label>
            <input id="review-author-email" name="reviewer_email" type="email" maxlength="160" placeholder="you@example.com" class="field" />
          </div>
          <div>
            <label for="review-title-input" class="label">Headline <span class="font-normal normal-case tracking-normal text-muted">(optional)</span></label>
            <input id="review-title-input" name="review_title" maxlength="120" placeholder="In a few words" class="field" />
          </div>
          <div class="sm:col-span-2">
            <label for="review-body-input" class="label">Your review</label>
            <textarea id="review-body-input" name="review_body" required maxlength="2000" rows="5" placeholder="What stayed with you?" class="field"></textarea>
          </div>
          <div class="sm:col-span-2">
            <button type="submit" class="btn btn-primary w-full sm:w-auto">Publish review</button>
            <p id="book-review-status" class="mt-3 min-h-5 text-sm text-muted" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>

    <!-- Support -->
    <section class="theme-night bg-paper">
      <div class="wrap-narrow py-20 text-center sm:py-24">
        <p class="fleuron" aria-hidden="true"><span class="font-display text-2xl">❦</span></p>
        <p class="eyebrow mt-8">Support the work</p>
        <h2 class="mt-4 font-display text-[2.4rem] leading-tight sm:text-[3.2rem]">Enjoyed this book?</h2>
        <p class="mx-auto mt-5 max-w-xl font-serif text-[1.1rem] leading-relaxed text-ink-2">
          These books are free to read and download. If you would like to support the stories,
          artwork and faith-based creative work behind BLOSSOM, you can give by bank transfer.
        </p>
        <button type="button" id="support-project-button" aria-expanded="false" aria-controls="support-project-details" class="btn btn-gold mt-8">Support my work</button>
        <div id="support-project-details" hidden class="mx-auto mt-10 max-w-2xl border-t border-line pt-8 text-left">
          <p class="eyebrow-muted text-center">Bank transfer</p>
          <dl class="mt-6 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3">
            <div class="bg-surface p-5"><dt class="eyebrow-muted">Bank</dt><dd class="mt-2 font-display text-2xl text-ink">FCMB</dd></div>
            <div class="bg-surface p-5"><dt class="eyebrow-muted">Account number</dt><dd class="mt-2 font-display text-2xl tracking-wider text-ink">6683003010</dd></div>
            <div class="bg-surface p-5"><dt class="eyebrow-muted">Account name</dt><dd class="mt-2 font-display text-2xl text-ink">Olaoluwa Michael</dd></div>
          </dl>
          <p class="mt-7 text-center font-display text-2xl italic text-accent">God bless you as you give. Thank you.</p>
          <div class="mt-6 flex justify-center">
            <button type="button" id="copy-support-account" class="btn btn-ghost btn-sm">Copy account number</button>
          </div>
          <p id="support-copy-status" class="mt-3 text-center text-xs text-muted" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <div class="wrap py-12 text-center">
      <a href="/books" class="link-arrow"><span aria-hidden="true">←</span> Explore all books</a>
    </div>
  </div>

  {!isFree && (
    <script is:inline>
      const payButton = document.getElementById('paystack-button');
      const panel = document.getElementById('paystack-panel');
      const closeButton = document.getElementById('paystack-close');
      const form = document.getElementById('paystack-form');
      const errorBox = document.getElementById('paystack-error');
      const bookId = payButton?.getAttribute('data-book-id');

      const closePaystack = () => panel?.classList.replace('flex', 'hidden');
      payButton?.addEventListener('click', () => panel?.classList.replace('hidden', 'flex'));
      closeButton?.addEventListener('click', closePaystack);
      panel?.addEventListener('click', (event) => { if (event.target === panel) closePaystack(); });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = new FormData(form).get('email');
        const submit = form.querySelector('button[type="submit"]');
        if (submit) submit.textContent = 'Opening secure checkout…';
        errorBox?.classList.add('hidden');

        try {
          const response = await fetch('/api/payments/initialize', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookId, email })
          });
          const result = await response.json();
          if (!response.ok || !result.authorization_url) throw new Error(result.error || 'Unable to start payment.');
          window.location.href = result.authorization_url;
        } catch (error) {
          if (errorBox) { errorBox.textContent = error.message; errorBox.classList.remove('hidden'); }
          if (submit) submit.textContent = 'Continue to payment';
        }
      });
    </script>
  )}
  <script is:inline>
    const supportButton = document.getElementById('support-project-button');
    const supportDetails = document.getElementById('support-project-details');
    const copySupportAccount = document.getElementById('copy-support-account');
    const supportCopyStatus = document.getElementById('support-copy-status');

    supportButton?.addEventListener('click', () => {
      if (!supportDetails) return;
      const opening = supportDetails.hidden;
      supportDetails.hidden = !opening;
      supportButton.setAttribute('aria-expanded', String(opening));
      supportButton.textContent = opening ? 'Hide support details' : 'Support my work';
    });

    copySupportAccount?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('6683003010');
        if (supportCopyStatus) supportCopyStatus.textContent = 'Account number copied.';
      } catch {
        if (supportCopyStatus) supportCopyStatus.textContent = 'Account number: 6683003010';
      }
    });

    const reviewForm = document.getElementById('book-review-form');
    const reviewStatus = document.getElementById('book-review-status');

    reviewForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!reviewForm || !reviewStatus) return;
      reviewStatus.textContent = 'Publishing your review…';
      const submitButton = reviewForm.querySelector('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch('/api/book-reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(reviewForm).entries())),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'Review could not be published.');
        reviewForm.reset();
        reviewStatus.textContent = 'Thank you. Your review is now visible.';
        window.setTimeout(() => window.location.reload(), 700);
      } catch (error) {
        reviewStatus.textContent = error instanceof Error ? error.message : 'Review could not be published.';
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
