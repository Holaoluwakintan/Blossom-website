---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/BookCover.astro';
import DownloadGate from '../../components/DownloadGate.astro';
import BookOrderLink from '../../components/BookOrderLink.astro';
import { getBookCoverUrl, getBookDownloadUrl } from '../../lib/book-downloads';
import { formatDownloadCount } from '../../lib/content';
import { supabase, supabaseServer } from '../../lib/supabase';

export const prerender = false;

let { data: books, error } = await supabaseServer
  .from('books')
  .select('*')
  .eq('collection', 'blossom')
  .order('created_at', { ascending: false });

if ((error || !books || books.length === 0) && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('books')
    .select('*')
    .eq('collection', 'blossom')
    .order('created_at', { ascending: false });
  if (!fallback.error && fallback.data) {
    books = fallback.data;
  }
}

const collectionBooks = books ?? [];
const featuredBook = collectionBooks.find((book) => book.featured === true) || collectionBooks[0];

const otherBooks = collectionBooks.filter((book) => book.id !== featuredBook?.id);
---

<BaseLayout
  title="Books | BLOSSOM"
  description="Explore the books of Olaoluwa Michael."
>
  <div>
    <!-- Masthead -->
    <section class="wrap pb-10 pt-12 text-center sm:pb-14 sm:pt-20">
      <p class="eyebrow rise">BLOSSOM Books</p>
      <h1 class="display rise rise-1 mx-auto mt-6 max-w-4xl text-[3.1rem] sm:text-[4.6rem] lg:text-[5.4rem]">
        Stories. Ideas. <em>Worlds to discover.</em>
      </h1>
      <p class="lede rise rise-2 mx-auto mt-6 max-w-2xl">
        Enter the literary world of Olaoluwa Michael: stories, ideas, reflections and imagination
        created to inspire, challenge and leave something behind.
      </p>
      <div class="rise rise-3 mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a href="#collection" class="link-arrow">Browse the collection <span aria-hidden="true">↓</span></a>
        <a href="/books/other-authors" class="link-arrow">Books by other authors <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- Featured -->
    {!error && featuredBook && (
      <section class="band hairline-t hairline-b">
        <div class="wrap grid items-center gap-14 py-16 sm:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
          <a href={'/books/' + featuredBook.slug} class="book-hover mx-auto block w-full max-w-[17rem] sm:max-w-[20rem]" aria-label={`Explore ${featuredBook.title}`}>
            <BookCover src={getBookCoverUrl(featuredBook)} alt={`${featuredBook.title} book cover`} eager stage sizes="(min-width: 640px) 320px, 272px" />
          </a>
          <div class="reveal">
            <div class="flex flex-wrap items-center gap-2">
              <span class="chip chip-accent">Featured</span>
              {featuredBook.genre && <span class="chip">{featuredBook.genre}</span>}
            </div>
            <h2 class="mt-6 font-display text-[2.8rem] leading-[1.02] sm:text-[4rem]">{featuredBook.title}</h2>
            {featuredBook.subtitle && <p class="mt-3 font-display text-2xl italic text-ink-2 sm:text-[1.7rem]">{featuredBook.subtitle}</p>}
            <p class="meta mt-5">
              By {featuredBook.author}{featuredBook.publication_year && ` · ${featuredBook.publication_year}`} · {formatDownloadCount(featuredBook.download_count)}
            </p>
            {featuredBook.synopsis && <p class="mt-6 max-w-xl whitespace-pre-line font-serif text-[1.12rem] leading-[1.75] text-ink-2 line-clamp-[8]">{featuredBook.synopsis}</p>}
            <div class="mt-9 flex flex-wrap gap-3">
              <a href={'/books/' + featuredBook.slug} class="btn btn-ghost">Explore the book</a>
              <DownloadGate
                bookId={featuredBook.id}
                bookSlug={featuredBook.slug}
                bookTitle={featuredBook.title}
                downloadUrl={getBookDownloadUrl(featuredBook)}
                featured
              />
            </div>
            <p class="meta mt-5">Free to read. Download the digital edition, or order editions that are not yet digital.</p>
          </div>
        </div>
      </section>
    )}

    <!-- Collection -->
    <section id="collection" class="wrap scroll-mt-24 py-20 sm:py-28">
      <div class="section-head">
        <div>
          <p class="eyebrow">The collection</p>
          <h2 class="mt-3 font-display text-[2.4rem] leading-tight sm:text-[3.4rem]">More stories.</h2>
        </div>
        {!error && <p class="meta">{collectionBooks.length} {collectionBooks.length === 1 ? 'title' : 'titles'}</p>}
      </div>

      {error && (
        <div class="card mt-12 p-8 text-center">
          <p class="font-display text-2xl text-ink">We couldn’t load the books just now.</p>
          <p class="meta mt-2">Please refresh in a moment.</p>
        </div>
      )}

      {!error && otherBooks.length > 0 && (
        <div class="mt-12 grid grid-cols-2 gap-x-5 gap-y-16 sm:gap-x-10 lg:grid-cols-3 xl:grid-cols-4">
          {otherBooks.map((book, i) => (
            <article class={`flex flex-col reveal reveal-d${(i % 3) + 1}`}>
              <a href={'/books/' + book.slug} class="book-hover group block" aria-label={`Explore ${book.title}`}>
                <BookCover src={getBookCoverUrl(book)} alt={`${book.title} book cover`} sizes="(min-width: 1280px) 250px, (min-width: 1024px) 300px, 44vw" />
              </a>
              <div class="mt-6 flex flex-1 flex-col">
                {book.genre && <p class="eyebrow-muted">{book.genre}</p>}
                <h3 class="mt-2 font-display text-[1.45rem] leading-tight sm:text-[1.75rem]">
                  <a href={'/books/' + book.slug} class="hover:text-accent">{book.title}</a>
                </h3>
                {book.subtitle && <p class="mt-1 font-display text-base italic text-ink-2 sm:text-lg">{book.subtitle}</p>}
                {book.synopsis && <p class="mt-3 hidden font-serif leading-relaxed text-ink-2 sm:line-clamp-3">{book.synopsis}</p>}
                <p class="meta mt-3">Free · {formatDownloadCount(book.download_count)}</p>
                <div class="mt-auto flex flex-col items-start gap-2 pt-5">
                  <a href={'/books/' + book.slug} class="link-arrow">View book <span aria-hidden="true">→</span></a>
                  {book.slug === 'crack-the-algorithm' ? (
                    <BookOrderLink bookTitle={book.title} />
                  ) : (
                    <DownloadGate
                      bookId={book.id}
                      bookSlug={book.slug}
                      bookTitle={book.title}
                      downloadUrl={getBookDownloadUrl(book)}
                    />
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

      {!error && collectionBooks.length === 0 && (
        <p class="mt-12 text-center font-serif text-lg italic text-muted">No books here yet. New titles are on the way.</p>
      )}
    </section>

    <!-- Closing -->
    <section class="theme-night bg-paper">
      <div class="wrap py-24 text-center sm:py-28">
        <p class="fleuron" aria-hidden="true"><span class="font-display text-2xl">❦</span></p>
        <h2 class="mx-auto mt-8 max-w-3xl text-balance font-display text-[2.4rem] leading-[1.1] sm:text-[3.6rem]">Many stories leave something behind.</h2>
        <p class="mt-3 font-display text-[1.6rem] italic text-accent sm:text-[2.2rem]">Let these leave you closer to Jesus.</p>
        <p class="mx-auto mt-6 max-w-xl font-serif text-[1.08rem] leading-relaxed text-ink-2">Stories written to inspire, challenge, awaken faith and leave something meaningful in the heart.</p>
      </div>
    </section>
  </div>
</BaseLayout>
