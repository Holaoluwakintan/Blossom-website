---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/BookCover.astro';
import DownloadGate from '../../components/DownloadGate.astro';
import { getBookCoverUrl, getBookDownloadUrl } from '../../lib/book-downloads';
import { formatDownloadCount } from '../../lib/content';
import { supabase, supabaseServer } from '../../lib/supabase';

export const prerender = false;

let { data: books, error } = await supabaseServer
  .from('books')
  .select('*')
  .eq('collection', 'other-authors')
  .order('created_at', { ascending: false });

if ((error || !books) && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('books')
    .select('*')
    .eq('collection', 'other-authors')
    .order('created_at', { ascending: false });
  if (!fallback.error && fallback.data) {
    books = fallback.data;
    error = null;
  }
}

const otherAuthorBooks = books ?? [];
const formatPrice = (price: number | string | null) =>
  price == null || price === '' || Number(price) === 0 ? 'See seller' : `₦${Number(price).toLocaleString('en-NG')}`;
---

<BaseLayout
  title="Books by Other Authors | BLOSSOM"
  description="Discover selected books by other authors, including paid editions and books available through external sellers."
>
  <div>
    <section class="wrap pb-10 pt-12 text-center sm:pb-14 sm:pt-20">
      <a href="/books" class="link-arrow text-muted rise"><span aria-hidden="true">←</span> Olaoluwa’s books</a>
      <p class="eyebrow rise rise-1 mt-10">A curated shelf</p>
      <h1 class="display rise rise-1 mx-auto mt-6 max-w-4xl text-[3rem] sm:text-[4.4rem] lg:text-[5.2rem]">Books by <em>other authors.</em></h1>
      <p class="lede rise rise-2 mx-auto mt-6 max-w-2xl">
        Selected books from other writers. Some editions are free to download; others are paid and available through Selar or the seller’s own checkout.
      </p>
    </section>

    <section class="wrap pb-20 sm:pb-28">
      <div class="rule"></div>
      {error && (
        <div class="card mt-12 p-8 text-center">
          <p class="font-display text-2xl text-ink">We couldn’t load this shelf just now.</p>
          <p class="meta mt-2">Please refresh in a moment.</p>
        </div>
      )}

      {!error && otherAuthorBooks.length === 0 && (
        <p class="mt-12 text-center font-serif text-lg italic text-muted">No books on this shelf yet.</p>
      )}

      {!error && otherAuthorBooks.length > 0 && (
        <div class="mt-14 grid gap-x-10 gap-y-20 sm:grid-cols-2 lg:grid-cols-3">
          {otherAuthorBooks.map((book, index) => {
            const isPaid = book.access_type === 'paid' || Boolean(book.purchase_url);
            const purchaseUrl = typeof book.purchase_url === 'string' ? book.purchase_url.trim() : '';
            const downloadUrl = getBookDownloadUrl(book);
            return (
              <article class={`grid grid-cols-[8.5rem_1fr] gap-6 sm:flex sm:flex-col sm:gap-0 reveal reveal-d${(index % 3) + 1}`}>
                <a href={'/books/' + book.slug} class="book-hover block sm:mx-auto sm:w-[78%]" aria-label={`Explore ${book.title}`}>
                  <BookCover src={getBookCoverUrl(book)} alt={`${book.title} book cover`} sizes="(min-width: 1024px) 260px, (min-width: 640px) 36vw, 136px" />
                </a>
                <div class="flex flex-col sm:mt-9">
                  <p class="eyebrow">By {book.author || 'Guest author'}</p>
                  <h2 class="mt-2 font-display text-[1.6rem] leading-tight sm:text-[1.9rem]"><a href={'/books/' + book.slug} class="hover:text-accent">{book.title}</a></h2>
                  {book.subtitle && <p class="mt-1 font-display text-lg italic text-ink-2">{book.subtitle}</p>}
                  {book.genre && <p class="eyebrow-muted mt-3">{book.genre}</p>}
                  {book.synopsis && <p class="mt-3 hidden font-serif leading-relaxed text-ink-2 line-clamp-3 sm:block">{book.synopsis}</p>}
                  <p class="mt-4 font-display text-xl text-ink">{isPaid ? formatPrice(book.price_ngn) : 'Free'} <span class="meta ml-1 align-middle">{isPaid ? 'Paid edition' : formatDownloadCount(book.download_count)}</span></p>
                  <div class="mt-5 flex flex-col items-start gap-3">
                    {isPaid && purchaseUrl ? (
                      <a href={purchaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">Buy the book <span aria-hidden="true">↗</span></a>
                    ) : isPaid ? (
                      <span class="eyebrow-muted">Seller link coming soon</span>
                    ) : (
                      <DownloadGate bookId={book.id} bookSlug={book.slug} bookTitle={book.title} downloadUrl={downloadUrl} />
                    )}
                    <a href={'/books/' + book.slug} class="link-arrow">View book <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>

    <section class="band hairline-t">
      <div class="wrap-narrow py-20 text-center">
        <p class="eyebrow">The main collection</p>
        <h2 class="mt-4 font-display text-[2.3rem] leading-tight sm:text-[3rem]">Looking for Olaoluwa’s own books?</h2>
        <p class="mx-auto mt-4 max-w-xl font-serif text-[1.08rem] leading-relaxed text-ink-2">Return to the BLOSSOM collection for his books and how to read them.</p>
        <a href="/books" class="btn btn-primary mt-8">View his books</a>
      </div>
    </section>
  </div>
</BaseLayout>
