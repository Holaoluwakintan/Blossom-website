---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DailyVerseCard from '../../components/DailyVerseCard.astro';
import { liveVerses, lagosNow, shortDate, SITE_URL } from '../../lib/daily-verse';
import { optimizedImage } from '../../lib/image';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');

const now = lagosNow();
const posts = await liveVerses();
const current = posts[0] ?? null;
const isToday = current?.post_date === now.date;
const archive = posts.slice(1);
const title = current ? `${current.title} · Daily Verse | Olaoluwa Michael` : 'Daily Verse | Olaoluwa Michael';
const description = current ? `${current.caption} ${current.reference ? '(' + current.reference + ', KJV)' : ''}`.trim() : 'A new Bible verse every morning at 6:00 AM (Nigeria time), from Olaoluwa Michael.';
---

<BaseLayout title={title} description={description} image={current?.og_url || '/og-image.png'} rawImage={!!current?.og_url} imageWidth={current?.og_url ? 1200 : undefined} imageHeight={current?.og_url ? 630 : undefined} canonical={`${SITE_URL}/daily-verse`}>
  <section class="wrap pb-14 pt-10 sm:pt-16">
    {current ? (
      <DailyVerseCard post={current} label={isToday ? "Today's verse" : 'Latest verse'} />
    ) : (
      <div class="card mx-auto max-w-2xl p-10 text-center">
        <p class="eyebrow">Daily Verse</p>
        <h1 class="display mt-5 text-[2.6rem] sm:text-[3.4rem]">A new verse every morning.</h1>
        <p class="lede mt-5">The first Daily Verse arrives at 6:00 AM (Nigeria time). Come back then, or follow along on the WhatsApp Channel.</p>
        <a class="btn btn-primary btn-sm mt-8" href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x" target="_blank" rel="noopener noreferrer">Follow on WhatsApp</a>
      </div>
    )}
  </section>

  {archive.length > 0 && (
    <section class="wrap pb-20">
      <div class="section-head">
        <div>
          <p class="eyebrow">Archive</p>
          <h2 class="mt-3 font-display text-[2.2rem] leading-tight sm:text-[2.8rem]">Earlier verses.</h2>
        </div>
        <p class="meta">{posts.length} verses</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
        {archive.map((p) => (
          <a href={`/daily-verse/${p.post_date}`} class="group block">
            <img src={optimizedImage(p.thumb_url || p.media_url, 320)} alt={p.title} loading="lazy" decoding="async" width="216" height="384" class="w-full rounded-xl shadow-sm transition-transform group-hover:-translate-y-1" style="aspect-ratio:9/16;object-fit:cover" />
            <p class="meta mt-3">{shortDate(p.post_date)}</p>
            <p class="font-display text-xl leading-tight transition-colors group-hover:text-accent">{p.title}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet" />
</BaseLayout>
