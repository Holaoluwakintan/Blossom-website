---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DailyVerseCard from '../../components/DailyVerseCard.astro';
import { verseOn, longDate, lagosNow, SITE_URL } from '../../lib/daily-verse';

export const prerender = false;
const { date = '' } = Astro.params;
const post = await verseOn(date);
const validDate = /^\d{4}-\d{2}-\d{2}$/.test(date) && !Number.isNaN(Date.parse(date + 'T00:00:00Z')) && new Date(date + 'T00:00:00Z').toISOString().slice(0, 10) === date;
const upcoming = !post && validDate && date >= lagosNow().date;
if (!post && !upcoming) return Astro.redirect('/daily-verse', 302);
Astro.response.headers.set('Cache-Control', post ? 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400' : 'public, max-age=0, s-maxage=120');
const title = post ? `${post.title} · Daily Verse | Olaoluwa Michael` : 'Daily Verse | Olaoluwa Michael';
const description = post ? `${post.caption} ${post.reference ? '(' + post.reference + ', KJV)' : ''}`.trim() : `This verse goes live on ${longDate(date)} at 6:00 AM (Nigeria time).`;
---

<BaseLayout title={title} description={description} image={post?.og_url || '/og-image.png'} rawImage={!!post?.og_url} imageWidth={post?.og_url ? 1200 : undefined} imageHeight={post?.og_url ? 630 : undefined} canonical={`${SITE_URL}/daily-verse/${date}`}>
  <section class="wrap pb-16 pt-10 sm:pt-16">
    {post ? <DailyVerseCard post={post} /> : (
      <div class="card mx-auto max-w-2xl p-10 text-center">
        <p class="eyebrow">Daily Verse</p>
        <h1 class="display mt-5 text-[2.4rem]">Coming {longDate(date)}.</h1>
        <p class="lede mt-5">This verse goes live at 6:00 AM (Nigeria time).</p>
      </div>
    )}
    <p class="mt-12 text-center"><a class="link-arrow" href="/daily-verse">All daily verses <span aria-hidden="true">→</span></a></p>
  </section>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet" />
</BaseLayout>
