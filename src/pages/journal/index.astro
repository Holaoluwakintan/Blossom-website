---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import { supabase, supabaseServer } from '../../lib/supabase';
import { formatDate, formatRelativeFreshness, getContentDate, normalizeArtworkCategory } from '../../lib/content';

export const prerender = false;

let { data: posts, error } = await supabaseServer
  .from('journal_posts')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false, nullsFirst: false })
  .order('created_at', { ascending: false });

if ((error || !posts) && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('journal_posts')
    .select('*')
    .eq('published', true)
    .order('published_at', { ascending: false, nullsFirst: false })
    .order('created_at', { ascending: false });
  if (!fallback.error && fallback.data) {
    posts = fallback.data;
    error = null;
  }
}

let { data: allComments } = await supabaseServer
  .from('comments')
  .select('article_id, post_id, status');

if ((!allComments || allComments.length === 0) && supabaseServer !== supabase) {
  const fallback = await supabase
    .from('comments')
    .select('article_id, post_id, status');
  if (fallback.data) {
    allComments = fallback.data;
  }
}

const commentCounts: Record<string, number> = {};
(allComments ?? []).forEach((c: any) => {
  const status = String(c.status ?? '').trim().toUpperCase();
  const isVisible = status === 'APPROVED' || status === 'PUBLISHED' || status === 'ACTIVE' || !status || status === '';
  if (isVisible) {
    const aid = String(c.article_id ?? c.post_id ?? '');
    if (aid) {
      commentCounts[aid] = (commentCounts[aid] || 0) + 1;
    }
  }
});

const getCommentsCount = (id: string | null | undefined) => commentCounts[String(id ?? '')] || 0;

const publishedPosts = posts ?? [];
const featuredPost = publishedPosts.find((post) => post.featured) ?? publishedPosts[0];
const collectionPosts = featuredPost
  ? publishedPosts.filter((post) => post.id !== featuredPost.id)
  : publishedPosts;
const coverOf = (post: any) => post.cover_image_url || post.featured_image_url;
const commentLabel = (n: number) => `${n} ${n === 1 ? 'comment' : 'comments'}`;
const formatArticleCount = (value: number | string | null | undefined, label: string) => `${Number(value ?? 0).toLocaleString('en-NG')} ${label}`;

---

<BaseLayout
  title="Faith Journal | BLOSSOM"
  description="Bible-based reflections, Christian stories, and encouragement from Olaoluwa Michael."
>
  <div>
    <section class="wrap pb-12 pt-12 text-center sm:pb-16 sm:pt-20">
      <p class="eyebrow rise">The Faith Journal</p>
      <h1 class="display rise rise-1 mx-auto mt-6 max-w-4xl text-[3.2rem] sm:text-[4.8rem] lg:text-[5.6rem]">Reflections for <em>the journey.</em></h1>
      <p class="lede rise rise-2 mx-auto mt-6 max-w-2xl">Bible-based thoughts, stories and encouragement for everyday faith and ordinary seasons.</p>
    </section>

    <section class="wrap pb-20 sm:pb-28">
      {error && (
        <div class="card p-8 text-center">
          <p class="font-display text-2xl text-ink">The Journal couldn’t be loaded just now.</p>
          <p class="meta mt-2">Please refresh in a moment.</p>
        </div>
      )}

      {!error && publishedPosts.length === 0 && (
        <div class="card p-10 text-center">
          <p class="eyebrow">The Journal is growing</p>
          <h2 class="mt-4 font-display text-3xl">New reflections are coming soon.</h2>
        </div>
      )}

      {featuredPost && (
        <a href={`/journal/${featuredPost.slug.trim()}`} data-article-click={featuredPost.id} class="mat-hover group grid items-center gap-8 border-y border-line py-10 md:grid-cols-[1.05fr_0.95fr] md:gap-14 md:py-14">
          {coverOf(featuredPost) ? (
            <ArtFrame src={coverOf(featuredPost)} alt={featuredPost.title} ratio="16 / 10" width={960} eager sizes="(min-width: 768px) 600px, 92vw" />
          ) : (
            <div class="mat flex aspect-[16/10] items-center justify-center font-display text-4xl italic text-accent">BLOSSOM</div>
          )}
          <div>
            <p class="eyebrow">Featured reflection</p>
            <p class="meta mt-4">
              {normalizeArtworkCategory(featuredPost.category)}{featuredPost.published_at && ` · ${formatDate(featuredPost.published_at)}`}
            </p>
            <h2 class="mt-3 font-display text-[2.4rem] leading-[1.05] transition-colors group-hover:text-accent sm:text-[3.4rem]">{featuredPost.title}</h2>
            {featuredPost.excerpt && <p class="mt-5 font-serif text-[1.12rem] leading-relaxed text-ink-2 line-clamp-4">{featuredPost.excerpt}</p>}
            {featuredPost.bible_reference && <p class="mt-4 font-display text-xl italic text-accent">{featuredPost.bible_reference}</p>}
            <p class="meta mt-6">
              {formatRelativeFreshness(getContentDate(featuredPost))} · {formatArticleCount(featuredPost.view_count, 'views')} · <span data-comment-count-for={featuredPost.id}>{commentLabel(getCommentsCount(featuredPost.id))}</span>
            </p>
            <span class="link-arrow mt-7">Read the reflection <span aria-hidden="true">→</span></span>
          </div>
        </a>
      )}

      {collectionPosts.length > 0 && (
        <div class="mt-20">
          <div class="section-head">
            <div>
              <p class="eyebrow">From the Journal</p>
              <h2 class="mt-3 font-display text-[2.3rem] leading-tight sm:text-[3rem]">More reflections.</h2>
            </div>
            <p class="meta">{publishedPosts.length} reflections</p>
          </div>
          <div class="mt-12 grid gap-x-10 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
            {collectionPosts.map((post, i) => (
              <a href={`/journal/${post.slug.trim()}`} data-article-click={post.id} class={`mat-hover group flex flex-col reveal reveal-d${(i % 3) + 1}`}>
                {coverOf(post) && <ArtFrame src={coverOf(post)} alt={post.title} ratio="16 / 10" sizes="(min-width: 1024px) 380px, (min-width: 768px) 45vw, 92vw" />}
                <p class="eyebrow-muted mt-6">{normalizeArtworkCategory(post.category)}</p>
                <h3 class="mt-2 font-display text-[1.75rem] leading-[1.12] transition-colors group-hover:text-accent">{post.title}</h3>
                {post.excerpt && <p class="mt-3 font-serif leading-relaxed text-ink-2 line-clamp-3">{post.excerpt}</p>}
                <p class="meta mt-4">
                  {formatDate(post.published_at || post.created_at)} · {formatArticleCount(post.view_count, 'views')} · <span data-comment-count-for={post.id}>{commentLabel(getCommentsCount(post.id))}</span>
                </p>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-click]').forEach((link) => {
    link.addEventListener('click', () => {
      const articleId = link.dataset.articleClick;
      if (articleId) fetch('/api/views/click', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ articleId }), keepalive: true }).catch(() => {});
    });
  });

  // Hydrate comment count badges dynamically on client mount
  async function hydrateCommentCounts() {
    try {
      const response = await fetch('/api/comments');
      const data = await response.json();
      if (!data.success || !Array.isArray(data.comments)) return;

      const counts: Record<string, number> = {};
      data.comments.forEach((c: any) => {
        const id = String(c.article_id || c.post_id || '');
        if (id) counts[id] = (counts[id] || 0) + 1;
      });

      document.querySelectorAll<HTMLElement>('[data-comment-count-for]').forEach((el) => {
        const id = el.dataset.commentCountFor;
        if (id) {
          const count = counts[id] || 0;
          el.textContent = `${count} ${count === 1 ? 'comment' : 'comments'}`;
        }
      });
    } catch {}
  }
  hydrateCommentCounts();
</script>

