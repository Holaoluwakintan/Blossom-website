---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import ShareActions from '../../components/ShareActions.astro';
import { formatDate, formatRelativeFreshness, getContentDate } from '../../lib/content';

export const prerender = false;

const requestedSlug = (Astro.params.slug ?? '').trim();
const shareUrl = `https://olaoluwamichael.vercel.app/journal/${requestedSlug}`;

let { data: publishedRows, error: postError } = await supabase
  .from('journal_posts')
  .select('*')
  .eq('published', true);
if (postError) {
  const fallback = await supabase.from('journal_posts').select('*').eq('status', 'PUBLISHED');
  publishedRows = fallback.data;
  postError = fallback.error;
}

const post = (publishedRows ?? []).find(
  (row) => String(row.slug ?? '').trim() === requestedSlug,
) ?? null;

const { data: commentRows, error: commentsError } = post
  ? await supabase
      .from('comments')
      .select('*')
      .order('created_at', { ascending: false })
  : { data: [], error: null };

const comments = (commentRows ?? [])
  .filter((comment) => {
    const commentArticleId = comment.article_id ?? comment.post_id;
    const status = String(comment.status ?? '').trim().toUpperCase();
    const isVisible = status === 'APPROVED' || status === 'PUBLISHED' || !status || status === '';
    return String(commentArticleId) === String(post?.id) && isVisible;
  })
  .map((comment) => ({
    id: comment.id,
    name: comment.author_name ?? comment.name ?? comment.author ?? 'Reader',
    body: comment.content ?? comment.comment ?? comment.text ?? '',
    created_at: comment.created_at,
  }));

const paragraphs = (post?.content_markdown || '')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const formatArticleCount = (value: number | string | null | undefined, label: string) => `${Number(value ?? 0).toLocaleString('en-NG')} ${label}`;
---

<BaseLayout
  title={post ? `${post.title} | Faith Journal` : 'Journal Article | BLOSSOM'}
  description={post?.excerpt || 'A Bible-based reflection from the BLOSSOM Faith Journal.'}
>
  <main class="min-h-screen bg-[#02050B] text-[#F6F3EC]">
    {!post && (
      <section class="mx-auto max-w-3xl px-6 py-32 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-red-400">Article not found</p>
        <h1 class="mt-5 font-cinzel text-4xl font-bold">This reflection is unavailable.</h1>
        <a href="/journal" class="mt-8 inline-flex rounded-full bg-[#E8C868] px-7 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] transition-all hover:bg-[#F6F3EC] hover:shadow-[0_0_20px_rgba(232,200,104,0.3)]">Back to Journal →</a>
      </section>
    )}

    {post && (
      <>
        <article class="mx-auto max-w-4xl px-6 pb-20 pt-16 lg:pb-28 lg:pt-24">
          <a href="/journal" class="inline-flex items-center gap-2 rounded-full border border-white/10 px-4 py-2 font-mono text-xs uppercase tracking-widest text-[#E8C868] transition-colors hover:border-[#E8C868]/50 hover:bg-[#E8C868]/10">← Back to Journal</a>
          <p class="mt-10 font-mono text-xs uppercase tracking-[0.3em] text-[#E8C868]">{post.category}</p>
          <h1 class="mt-4 font-cinzel text-4xl font-bold leading-tight sm:text-6xl">{post.title}</h1>
          <p class="mt-6 font-mono text-xs uppercase tracking-widest text-slate-500">
            {formatDate(post.published_at || post.created_at)} · {formatRelativeFreshness(getContentDate(post))}{post.reading_time_minutes || post.reading_time ? ` · ${post.reading_time_minutes || post.reading_time} min read` : ''}
          </p>
          <p class="mt-3 flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-widest text-slate-500">
            <span>{formatArticleCount(post.view_count, 'views')}</span>
            <span>·</span>
            <span>{formatArticleCount(post.click_count, 'clicks')}</span>
            <span>·</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E8C868]/10 px-2.5 py-0.5 text-[#E8C868] border border-[#E8C868]/20">
              💬 <span id="comments-count-stat">{comments.length}</span> {comments.length === 1 ? 'comment' : 'comments'}
            </span>
          </p>

          {(post.cover_image_url || post.featured_image_url) && (
            <div class="mt-12 overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
              <img src={post.cover_image_url || post.featured_image_url} alt={post.title} class="max-h-[520px] w-full object-cover transition-transform duration-700 hover:scale-[1.02]" />
            </div>
          )}

          {(post.bible_reference || post.bible_verse) && (
            <aside class="my-12 rounded-2xl border-l-4 border-[#E8C868] bg-[#080D16] p-7 sm:p-8 shadow-xl">
              {post.bible_reference && <p class="font-mono text-xs uppercase tracking-widest text-[#E8C868]">{post.bible_reference}</p>}
              {post.bible_verse && <p class="mt-3 font-editorial text-xl italic leading-8 text-slate-300 sm:text-2xl">“{post.bible_verse}”</p>}
            </aside>
          )}

          <div class="prose prose-invert mt-12 max-w-none prose-headings:font-cinzel prose-headings:text-[#F6F3EC] prose-p:leading-8 prose-p:text-slate-300 prose-strong:text-[#F6F3EC] prose-blockquote:border-[#E8C868] prose-blockquote:text-[#E8C868]">
            {paragraphs.map((paragraph) => {
              const heading = paragraph.startsWith('# ');
              const text = heading ? paragraph.slice(2) : paragraph;
              return heading ? <h2>{text}</h2> : <p>{text}</p>;
            })}
          </div>

          <ShareActions title={post.title} url={shareUrl} label="Share this reflection" />
        </article>

        <section class="border-t border-white/10 bg-[#050912]">
          <div class="mx-auto grid max-w-7xl gap-16 px-6 py-20 lg:grid-cols-[1fr_0.85fr] lg:py-28">
            <div>
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#E8C868]">Community response</p>
                  <h2 class="mt-3 font-cinzel text-3xl font-bold">Thoughts from readers.</h2>
                </div>
                <span class="rounded-full border border-[#E8C868]/30 bg-[#E8C868]/10 px-3.5 py-1.5 font-mono text-xs text-[#E8C868]">
                  <span id="comments-badge-count">{comments.length}</span> responses
                </span>
              </div>

              {commentsError && <p class="mt-6 text-sm text-red-400">Approved comments could not be loaded.</p>}
              <p id="no-comments-msg" class={`mt-6 leading-8 text-slate-400 ${comments && comments.length > 0 ? 'hidden' : ''}`}>
                Be the first person to share a thoughtful response.
              </p>

              <div id="comments-list" class="mt-8 space-y-5">
                {comments?.map((comment) => (
                  <article class="rounded-2xl border border-white/10 bg-[#080D16] p-6 sm:p-7 transition-all duration-300 hover:border-[#E8C868]/40 hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(232,200,104,0.08)]">
                    <div class="flex items-center justify-between gap-2">
                      <p class="font-mono text-xs uppercase tracking-widest text-[#E8C868]">{comment.name}</p>
                      <span class="font-mono text-[10px] uppercase tracking-widest text-slate-500">{formatDate(comment.created_at)}</span>
                    </div>
                    <p class="mt-3 leading-8 text-slate-300 whitespace-pre-line">{comment.body}</p>
                  </article>
                ))}
              </div>
            </div>

            <div>
              <div class="rounded-3xl border border-[#E8C868]/25 bg-[#080D16] p-7 sm:p-9 shadow-2xl">
                <p class="font-mono text-xs uppercase tracking-[0.3em] text-[#E8C868]">Join the conversation</p>
                <h2 class="mt-3 font-cinzel text-2xl sm:text-3xl font-bold">Leave a response.</h2>
                <p class="mt-3 leading-7 text-slate-400 text-sm">Your response will appear immediately below. Please keep your contribution thoughtful and respectful.</p>
                <form id="comment-form" class="mt-7 space-y-4">
                  <input type="hidden" name="post_id" value={post.id} />
                  <div>
                    <label for="comment-author-name" class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400 mb-1.5">Your Name</label>
                    <input id="comment-author-name" name="name" required maxlength="80" placeholder="e.g. Mary Adams" class="w-full rounded-xl border border-white/15 bg-[#02050B] px-4 py-3.5 text-[#F6F3EC] outline-none transition-colors placeholder:text-slate-600 focus:border-[#E8C868] focus:ring-2 focus:ring-[#E8C868]/20" />
                  </div>
                  <div>
                    <label for="comment-author-email" class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400 mb-1.5">Email (kept private)</label>
                    <input id="comment-author-email" name="email" type="email" required maxlength="160" placeholder="you@example.com" class="w-full rounded-xl border border-white/15 bg-[#02050B] px-4 py-3.5 text-[#F6F3EC] outline-none transition-colors placeholder:text-slate-600 focus:border-[#E8C868] focus:ring-2 focus:ring-[#E8C868]/20" />
                  </div>
                  <div>
                    <label for="comment-body" class="block text-xs font-mono uppercase tracking-[0.18em] text-slate-400 mb-1.5">Your Comment</label>
                    <textarea id="comment-body" name="body" required maxlength="2000" rows="5" placeholder="Share your reflection or thoughts on this article..." class="w-full rounded-xl border border-white/15 bg-[#02050B] px-4 py-3.5 text-[#F6F3EC] outline-none transition-colors placeholder:text-slate-600 focus:border-[#E8C868] focus:ring-2 focus:ring-[#E8C868]/20"></textarea>
                  </div>
                  <button type="submit" id="comment-submit-btn" class="w-full rounded-full bg-[#E8C868] px-7 py-4 font-mono text-xs font-bold uppercase tracking-widest text-[#02050B] transition-all hover:bg-[#F6F3EC] hover:shadow-[0_0_20px_rgba(232,200,104,0.3)] disabled:cursor-wait disabled:opacity-60">
                    Publish response →
                  </button>
                  <p id="comment-status" class="min-h-5 text-sm text-slate-400" aria-live="polite"></p>
                </form>
              </div>
            </div>
          </div>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<script>
  const articleId = document.querySelector('input[name="post_id"]')?.getAttribute('value');
  if (articleId) {
    const key = `blossom-viewer-${articleId}`;
    let viewerHash = localStorage.getItem(key);
    if (!viewerHash) {
      viewerHash = crypto.randomUUID();
      localStorage.setItem(key, viewerHash);
    }
    fetch('/api/views/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ articleId, viewerHash }) }).catch(() => {});
  }

  const form = document.querySelector('#comment-form');
  const status = document.querySelector('#comment-status');
  const submitBtn = document.querySelector('#comment-submit-btn') as HTMLButtonElement | null;
  const commentsList = document.querySelector('#comments-list');
  const noCommentsMsg = document.querySelector('#no-comments-msg');
  const statBadge = document.querySelector('#comments-count-stat');
  const countBadge = document.querySelector('#comments-badge-count');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Publishing response…';
    }
    status.textContent = 'Submitting your response…';
    status.className = 'min-h-5 text-sm text-slate-400';

    const formData = new FormData(form as HTMLFormElement);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Comment could not be submitted.');

      (form as HTMLFormElement).reset();
      status.textContent = '✨ Thank you! Your response is now live below.';
      status.className = 'min-h-5 text-sm text-[#E8C868] font-medium';

      // Instantly render the new comment into the DOM!
      if (noCommentsMsg) (noCommentsMsg as HTMLElement).classList.add('hidden');

      if (commentsList) {
        const commentData = result.comment || {
          name: payload.name || 'Reader',
          body: payload.body || '',
          created_at: new Date().toISOString(),
        };

        const newCard = document.createElement('article');
        newCard.className = 'rounded-2xl border border-[#E8C868]/60 bg-[#080D16] p-6 sm:p-7 transition-all duration-500 shadow-[0_0_30px_rgba(232,200,104,0.18)] animate-[fade-in_0.6s_ease-out] ring-1 ring-[#E8C868]/30';

        const topDiv = document.createElement('div');
        topDiv.className = 'flex items-center justify-between gap-2';

        const nameEl = document.createElement('p');
        nameEl.className = 'font-mono text-xs uppercase tracking-widest text-[#E8C868] font-bold';
        nameEl.textContent = String(commentData.name || 'Reader');

        const nowBadge = document.createElement('span');
        nowBadge.className = 'rounded-full bg-[#E8C868]/20 px-2.5 py-0.5 font-mono text-[9px] uppercase tracking-wider text-[#E8C868]';
        nowBadge.textContent = 'Just now';

        topDiv.appendChild(nameEl);
        topDiv.appendChild(nowBadge);

        const bodyEl = document.createElement('p');
        bodyEl.className = 'mt-3 leading-8 text-[#F6F3EC] whitespace-pre-line';
        bodyEl.textContent = String(commentData.body || '');

        newCard.appendChild(topDiv);
        newCard.appendChild(bodyEl);

        commentsList.prepend(newCard);
        newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // Update counters
        if (statBadge) {
          const count = (parseInt(statBadge.textContent || '0', 10) || 0) + 1;
          statBadge.textContent = String(count);
        }
        if (countBadge) {
          const count = (parseInt(countBadge.textContent || '0', 10) || 0) + 1;
          countBadge.textContent = String(count);
        }
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Comment could not be submitted.';
      status.className = 'min-h-5 text-sm text-red-400';
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Publish response →';
      }
    }
  });
</script>

