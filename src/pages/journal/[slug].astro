---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import { supabase, supabaseServer } from '../../lib/supabase';
import ShareActions from '../../components/ShareActions.astro';
import { formatDate, formatRelativeFreshness, getContentDate, normalizeArtworkCategory } from '../../lib/content';

export const prerender = false;

const requestedSlug = (Astro.params.slug ?? '').trim();
const shareUrl = `https://olaoluwamichael.vercel.app/journal/${requestedSlug}`;

let { data: publishedRows, error: postError } = await supabase
  .from('journal_posts')
  .select('*')
  .eq('published', true);
if (postError) {
  const fallback = await supabase.from('journal_posts').select('*').eq('status', 'PUBLISHED');
  publishedRows = fallback.data;
  postError = fallback.error;
}

const post = (publishedRows ?? []).find(
  (row) => String(row.slug ?? '').trim() === requestedSlug,
) ?? null;

const { data: commentRows, error: commentsError } = post
  ? await supabaseServer
      .from('comments')
      .select('id, article_id, author_name, content, status, created_at')
      .eq('article_id', post.id)
      .order('created_at', { ascending: false })
  : { data: [], error: null };

if (!post) Astro.response.status = 404;

const comments = (commentRows ?? [])
  .filter((comment) => {
    const status = String(comment.status ?? '').trim().toUpperCase();
    return status === 'APPROVED' || status === 'PUBLISHED' || status === 'ACTIVE' || !status;
  })
  .map((comment) => ({
    id: comment.id,
    name: comment.author_name ?? 'Reader',
    body: comment.content ?? '',
    created_at: comment.created_at,
  }));

const paragraphs = (post?.content_markdown || '')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const coverImage = post?.cover_image_url || post?.featured_image_url;
const formatArticleCount = (value: number | string | null | undefined, label: string) => `${Number(value ?? 0).toLocaleString('en-NG')} ${label}`;
---

<BaseLayout
  title={post ? `${post.title} | Faith Journal` : 'Journal Article | BLOSSOM'}
  description={post?.excerpt || 'A Bible-based reflection from the BLOSSOM Faith Journal.'}
  image={coverImage || undefined}
>
  <div>
    {!post && (
      <section class="wrap-narrow py-28 text-center sm:py-36">
        <p class="eyebrow">Not found</p>
        <h1 class="display mt-5 text-[2.8rem] sm:text-6xl">This reflection is <em>unavailable.</em></h1>
        <p class="lede mx-auto mt-5 max-w-md">It may have moved or been unpublished. The rest of the Journal is waiting for you.</p>
        <a href="/journal" class="btn btn-primary mt-9">Back to the Journal</a>
      </section>
    )}

    {post && (
      <>
        <article>
          <header class="wrap-narrow pt-8 text-center sm:pt-12">
            <a href="/journal" class="link-arrow text-muted"><span aria-hidden="true">←</span> The Journal</a>
            {post.category && <p class="eyebrow rise mt-10">{normalizeArtworkCategory(post.category)}</p>}
            <h1 class="display rise rise-1 mx-auto mt-5 max-w-3xl text-balance text-[2.6rem] sm:text-[3.8rem] lg:text-[4.3rem]">{post.title}</h1>
            <p class="meta rise rise-2 mt-6">
              {formatDate(post.published_at || post.created_at)}{post.reading_time_minutes || post.reading_time ? ` · ${post.reading_time_minutes || post.reading_time} min read` : ''} · {formatArticleCount(post.view_count, 'views')} · <span id="comments-count-stat">{comments.length}</span> {comments.length === 1 ? 'comment' : 'comments'}
            </p>
            <p class="fleuron mt-8" aria-hidden="true"><span class="font-display text-xl">❦</span></p>
          </header>

          {coverImage && (
            <figure class="wrap mt-10 max-w-5xl rise rise-2">
              <ArtFrame src={coverImage} alt={post.title} ratio="16 / 10" width={1280} eager sizes="(min-width: 1024px) 960px, 100vw" class="shadow-[0_30px_60px_-40px_rgb(var(--shadow)/0.6)]" />
            </figure>
          )}

          <div class="wrap-narrow pb-16 pt-12 sm:pt-16">
            {(post.bible_reference || post.bible_verse) && (
              <aside class="mb-12 border-y border-line py-8 text-center">
                {post.bible_verse && <p class="font-display text-[1.6rem] italic leading-snug text-ink sm:text-[1.9rem]">“{post.bible_verse}”</p>}
                {post.bible_reference && <p class="eyebrow mt-4">{post.bible_reference}</p>}
              </aside>
            )}

            <div class="prose-literary drop-cap">
              {paragraphs.map((paragraph) => {
                const heading = paragraph.startsWith('# ');
                const text = heading ? paragraph.slice(2) : paragraph;
                return heading ? <h2>{text}</h2> : <p>{text}</p>;
              })}
            </div>

            <p class="mt-14 text-center font-display text-2xl italic text-accent">— {post.author_name || post.author || 'Olaoluwa Michael'}</p>

            <ShareActions title={post.title} url={shareUrl} label="Share this reflection" />
          </div>
        </article>

        <section class="band hairline-t">
          <div class="wrap grid gap-16 py-20 sm:py-24 lg:grid-cols-[1fr_0.85fr]">
            <div>
              <div class="flex items-end justify-between gap-4 border-b border-line pb-6">
                <div>
                  <p class="eyebrow">Community response</p>
                  <h2 class="mt-3 font-display text-[2.2rem] leading-tight sm:text-[2.7rem]">Thoughts from readers</h2>
                </div>
                <span class="meta"><span id="comments-badge-count">{comments.length}</span> responses</span>
              </div>

              {commentsError && <p class="mt-6 text-sm text-wine">Responses could not be loaded right now.</p>}
              <p id="no-comments-msg" class={`mt-6 font-serif text-lg italic text-muted ${comments && comments.length > 0 ? 'hidden' : ''}`}>
                Be the first to share a thoughtful response.
              </p>

              <div id="comments-list">
                {comments?.map((comment) => (
                  <article class="border-b border-line py-7">
                    <div class="flex items-center justify-between gap-2">
                      <p class="font-display text-xl text-ink">{comment.name}</p>
                      <span class="meta">{formatDate(comment.created_at)}</span>
                    </div>
                    <p class="mt-2 whitespace-pre-line font-serif text-[1.08rem] leading-relaxed text-ink-2">{comment.body}</p>
                  </article>
                ))}
              </div>
            </div>

            <div>
              <div class="card p-6 sm:p-9 lg:sticky lg:top-28">
                <p class="eyebrow">Join the conversation</p>
                <h2 class="mt-3 font-display text-[2rem] leading-tight">Leave a response</h2>
                <p class="mt-3 font-serif text-[1.02rem] leading-relaxed text-ink-2">Your response appears straight away. Please keep it thoughtful and kind.</p>
                <form id="comment-form" class="mt-7 space-y-5">
                  <input type="hidden" name="post_id" value={post.id} />
                  <div>
                    <label for="comment-author-name" class="label">Your name</label>
                    <input id="comment-author-name" name="name" required maxlength="80" placeholder="e.g. Mary Adams" class="field" />
                  </div>
                  <div>
                    <label for="comment-author-email" class="label">Email <span class="font-normal normal-case tracking-normal text-muted">(kept private)</span></label>
                    <input id="comment-author-email" name="email" type="email" required maxlength="160" placeholder="you@example.com" class="field" />
                  </div>
                  <div>
                    <label for="comment-body" class="label">Your response</label>
                    <textarea id="comment-body" name="body" required maxlength="2000" rows="5" placeholder="What stayed with you?" class="field"></textarea>
                  </div>
                  <button type="submit" id="comment-submit-btn" class="btn btn-primary w-full">Publish response</button>
                  <p id="comment-status" class="min-h-5 text-sm text-muted" aria-live="polite"></p>
                </form>
              </div>
            </div>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>

<script>
  const articleId = document.querySelector('input[name="post_id"]')?.getAttribute('value');
  if (articleId) {
    const key = `blossom-viewer-${articleId}`;
    let viewerHash = localStorage.getItem(key);
    if (!viewerHash) {
      viewerHash = crypto.randomUUID();
      localStorage.setItem(key, viewerHash);
    }
    fetch('/api/views/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ articleId, viewerHash }) }).catch(() => {});
  }

  const form = document.querySelector('#comment-form');
  const status = document.querySelector('#comment-status');
  const submitBtn = document.querySelector('#comment-submit-btn') as HTMLButtonElement | null;
  const commentsList = document.querySelector('#comments-list');
  const noCommentsMsg = document.querySelector('#no-comments-msg');
  const statBadge = document.querySelector('#comments-count-stat');
  const countBadge = document.querySelector('#comments-badge-count');

  // Real-time client-side hydration for comments:
  // Fetches latest comments so any freshly approved or submitted comments show immediately
  if (articleId && commentsList) {
    fetch(`/api/comments?articleId=${encodeURIComponent(articleId)}`)
      .then((r) => r.json())
      .then((data) => {
        if (data.comments && Array.isArray(data.comments) && data.comments.length > 0) {
          if (noCommentsMsg) (noCommentsMsg as HTMLElement).classList.add('hidden');
          commentsList.innerHTML = '';
          data.comments.forEach((c: any) => {
            const card = document.createElement('article');
            card.className = 'border-b border-line py-7';
            const top = document.createElement('div');
            top.className = 'flex items-center justify-between gap-2';
            const author = document.createElement('p');
            author.className = 'font-display text-xl text-ink';
            author.textContent = c.name || 'Reader';
            const dateSpan = document.createElement('span');
            dateSpan.className = 'meta';
            dateSpan.textContent = c.created_at ? new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
            top.appendChild(author);
            top.appendChild(dateSpan);
            const body = document.createElement('p');
            body.className = 'mt-2 whitespace-pre-line font-serif text-[1.08rem] leading-relaxed text-ink-2';
            body.textContent = c.body || '';
            card.appendChild(top);
            card.appendChild(body);
            commentsList.appendChild(card);
          });
          if (statBadge) statBadge.textContent = String(data.comments.length);
          if (countBadge) countBadge.textContent = String(data.comments.length);
        }
      })
      .catch(() => {});
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Publishing response…';
    }
    status.textContent = 'Submitting your response…';
    status.className = 'min-h-5 text-sm text-muted';

    const formData = new FormData(form as HTMLFormElement);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Comment could not be submitted.');

      (form as HTMLFormElement).reset();
      status.textContent = 'Thank you. Your response is now live below.';
      status.className = 'min-h-5 text-sm font-medium text-accent';

      // Instantly render the new comment into the DOM!
      if (noCommentsMsg) (noCommentsMsg as HTMLElement).classList.add('hidden');

      if (commentsList) {
        const commentData = result.comment || {
          name: payload.name || 'Reader',
          body: payload.body || '',
          created_at: new Date().toISOString(),
        };

        const newCard = document.createElement('article');
        newCard.className = 'rise border-b border-line bg-accent/5 px-4 py-7';

        const topDiv = document.createElement('div');
        topDiv.className = 'flex items-center justify-between gap-2';

        const nameEl = document.createElement('p');
        nameEl.className = 'font-display text-xl text-ink';
        nameEl.textContent = String(commentData.name || 'Reader');

        const nowBadge = document.createElement('span');
        nowBadge.className = 'chip chip-accent';
        nowBadge.textContent = 'Just now';

        topDiv.appendChild(nameEl);
        topDiv.appendChild(nowBadge);

        const bodyEl = document.createElement('p');
        bodyEl.className = 'mt-2 whitespace-pre-line font-serif text-[1.08rem] leading-relaxed text-ink';
        bodyEl.textContent = String(commentData.body || '');

        newCard.appendChild(topDiv);
        newCard.appendChild(bodyEl);

        commentsList.prepend(newCard);
        newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // Update counters
        if (statBadge) {
          const count = (parseInt(statBadge.textContent || '0', 10) || 0) + 1;
          statBadge.textContent = String(count);
        }
        if (countBadge) {
          const count = (parseInt(countBadge.textContent || '0', 10) || 0) + 1;
          countBadge.textContent = String(count);
        }
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Comment could not be submitted.';
      status.className = 'min-h-5 text-sm text-wine';
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Publish response';
      }
    }
  });
</script>

