---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import { supabase } from '../../lib/supabase';
import { normalizeArtworkCategory, normalizeArtworkText } from '../../lib/content';

export const prerender = false;

let { data: artworks, error } = await supabase
  .from('artworks')
  .select('*')
  .order('created_at', { ascending: false });

// Keep the gallery working with older artworks schemas that do not have created_at.
if (error) {
  const fallback = await supabase.from('artworks').select('*');
  artworks = fallback.data;
  error = fallback.error;
}

const featuredArtwork = artworks?.find((artwork) => artwork.featured === true);
const galleryArtworks = artworks?.filter((artwork) => artwork.featured !== true) ?? [];
---

<BaseLayout title="Imagination World | BLOSSOM" description="A visual collection of stickman art, reflections, and faith by Olaoluwa Michael.">
  <div>
    <section class="wrap pb-12 pt-12 text-center sm:pb-16 sm:pt-20">
      <p class="eyebrow rise">BLOSSOM presents</p>
      <h1 class="display rise rise-1 mx-auto mt-6 max-w-4xl text-[3.4rem] sm:text-[5rem] lg:text-[6rem]">Imagination <em>World.</em></h1>
      <p class="lede rise rise-2 mx-auto mt-6 max-w-2xl">Stickman stories about faith, life, hope and the quiet truths that stay with us.</p>
    </section>

    {error ? (
      <section class="wrap py-20 text-center"><p class="font-serif text-lg italic text-muted">The gallery couldn’t be loaded just now. Please refresh in a moment.</p></section>
    ) : artworks && artworks.length > 0 ? (
      <>
        {featuredArtwork && (
          <section class="band hairline-t hairline-b">
            <div class="wrap grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2 lg:gap-20">
              <a href={'/imagination/' + featuredArtwork.slug} class="mat-hover frame mx-auto block w-full max-w-lg">
                <ArtFrame src={featuredArtwork.image_url} alt={featuredArtwork.alt_text || featuredArtwork.title} width={960} eager sizes="(min-width: 1024px) 500px, 90vw" />
              </a>
              <div class="reveal">
                <p class="eyebrow">Featured artwork</p>
                {featuredArtwork.category && <p class="eyebrow-muted mt-5">{normalizeArtworkCategory(featuredArtwork.category)}</p>}
                <h2 class="mt-3 font-display text-[2.6rem] leading-[1.05] sm:text-[3.6rem]">{normalizeArtworkText(featuredArtwork.title)}</h2>
                {featuredArtwork.caption && <p class="mt-4 font-display text-[1.5rem] italic leading-snug text-accent">{normalizeArtworkText(featuredArtwork.caption)}</p>}
                {featuredArtwork.story && <p class="mt-6 font-serif text-[1.12rem] leading-[1.75] text-ink-2 line-clamp-6">{normalizeArtworkText(featuredArtwork.story)}</p>}
                <a href={'/imagination/' + featuredArtwork.slug} class="btn btn-primary mt-8">View the artwork</a>
              </div>
            </div>
          </section>
        )}

        <section class="wrap py-20 sm:py-28">
          <div class="section-head">
            <div>
              <p class="eyebrow">The gallery</p>
              <h2 class="mt-3 font-display text-[2.4rem] leading-tight sm:text-[3.4rem]">Pause. Look closer.</h2>
            </div>
            <p class="meta">{galleryArtworks.length} works</p>
          </div>
          <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-16 lg:grid-cols-3">
            {galleryArtworks.map((artwork, i) => (
              <article class={`reveal reveal-d${(i % 3) + 1}`}>
                <a href={'/imagination/' + artwork.slug} class="mat-hover group block">
                  <div class="frame transition-transform duration-500 group-hover:-translate-y-1">
                    <ArtFrame src={artwork.image_url} alt={artwork.alt_text || artwork.title} sizes="(min-width: 1024px) 360px, 45vw" />
                  </div>
                  <div class="pt-5">
                    {artwork.category && <p class="eyebrow-muted text-[0.625rem] sm:text-[0.6875rem]">{normalizeArtworkCategory(artwork.category)}</p>}
                    <h3 class="mt-1.5 font-display text-[1.3rem] leading-tight transition-colors group-hover:text-accent sm:text-[1.65rem]">{normalizeArtworkText(artwork.title)}</h3>
                    {artwork.caption && <p class="mt-1 font-display text-base italic leading-snug text-ink-2 line-clamp-2 sm:text-lg">{normalizeArtworkText(artwork.caption)}</p>}
                  </div>
                </a>
              </article>
            ))}
          </div>
          <p class="mx-auto mt-16 max-w-xl text-center text-sm leading-relaxed text-muted">Public artworks may be opened and saved in their watermarked form. They are shared for reflection within the BLOSSOM faith-based creative world.</p>
        </section>
      </>
    ) : (
      <section class="wrap py-24 text-center">
        <p class="eyebrow">The gallery is growing</p>
        <h2 class="mt-5 font-display text-4xl">New imagination is on its way.</h2>
      </section>
    )}
  </div>
</BaseLayout>
