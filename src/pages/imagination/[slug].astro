---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import ShareActions from '../../components/ShareActions.astro';

export const prerender = false;

const { slug } = Astro.params;
const shareUrl = `https://olaoluwamichael.vercel.app/imagination/${String(slug ?? '').trim()}`;

const { data: artwork, error } = await supabase
  .from('artworks')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if (error || !artwork) {
  throw new Error(`Artwork not found. Slug: ${slug}. Supabase error: ${error?.message ?? 'No artwork returned'}`);
}


---

<BaseLayout
  title={`${artwork.title} | Imagination World | BLOSSOM`}
  description={artwork.caption || artwork.story || `Explore ${artwork.title} in Imagination World.`}
  image={artwork.image_url}
  canonical={`https://olaoluwamichael.vercel.app/imagination/${artwork.slug}`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: artwork.title,
    image: artwork.image_url,
    description: artwork.caption || artwork.story,
    artMedium: 'Digital illustration',
    artform: 'Faith-based stickman artwork',
    creator: { '@type': 'Person', name: 'Olaoluwa Michael' },
    url: `https://olaoluwamichael.vercel.app/imagination/${artwork.slug}`,
  }}
>
  <main class="min-h-screen bg-[#02050B] text-[#F6F3EC]">
    <section class="max-w-7xl mx-auto px-6 pt-8 lg:pt-12">
      <a href="/imagination" class="inline-flex items-center gap-3 text-xs font-mono uppercase tracking-[0.2em] text-slate-400 hover:text-[#E8C868] transition-colors"><span class="text-lg">←</span> Back to Imagination World</a>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-12 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="relative max-w-2xl mx-auto lg:mx-0 w-full">
          <div class="absolute -inset-6 bg-[#E8C868]/8 blur-3xl rounded-full"></div>
          <div class="relative overflow-hidden border border-[#E8C868]/20 bg-[#080D16]"><img src={artwork.image_url} alt={artwork.alt_text || artwork.title} class="w-full aspect-square object-contain" /></div>
        </div>

        <div class="lg:pt-5">
          {artwork.category && <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#E8C868]">{artwork.category}</p>}
          <h1 class="font-cinzel text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mt-4">{artwork.title}</h1>
          {artwork.caption && <p class="font-editorial italic text-xl sm:text-2xl text-[#E8C868] mt-4">{artwork.caption}</p>}

          {artwork.story && (
            <div class="mt-9">
              <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-slate-500 mb-3">The meaning</p>
              <p class="text-slate-300 text-lg leading-relaxed whitespace-pre-line">{artwork.story}</p>
            </div>
          )}

          {artwork.moral_quote && (
            <blockquote class="border-l-2 border-[#E8C868] pl-5 mt-9">
              <p class="font-editorial italic text-2xl leading-relaxed text-[#F6F3EC]">“{artwork.moral_quote}”</p>
            </blockquote>
          )}

          <div class="border-t border-white/10 mt-10 pt-7">
            <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-slate-500 mb-4">Artwork access</p>
            <a href={artwork.image_url} target="_blank" rel="noopener noreferrer" download class="inline-flex items-center justify-center px-7 py-4 border border-white/20 text-[#F6F3EC] font-mono text-xs font-bold uppercase tracking-widest hover:border-[#E8C868] hover:text-[#E8C868] transition-colors">Open / Save Watermarked Artwork</a>
            <p class="text-xs leading-6 text-slate-500 mt-5">This artwork is part of the BLOSSOM faith-based creative world. The public gallery version is watermarked and is displayed for reflection, not sale.</p>
            <ShareActions title={artwork.title} url={shareUrl} label="Share this artwork" />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
