---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import { supabase } from '../../lib/supabase';
import ShareActions from '../../components/ShareActions.astro';

export const prerender = false;

const { slug } = Astro.params;
const shareUrl = `https://olaoluwamichael.vercel.app/imagination/${String(slug ?? '').trim()}`;

const { data: artwork, error } = await supabase
  .from('artworks')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if (error || !artwork) {
  // Unknown artwork: send visitors back to the gallery instead of a 500 error page.
  if (error) console.error('[imagination] lookup failed', slug, error.message);
  return Astro.redirect('/imagination', 302);
}


---

<BaseLayout
  title={`${artwork.title} | Imagination World | BLOSSOM`}
  description={artwork.caption || artwork.story || `Explore ${artwork.title} in Imagination World.`}
  image={artwork.image_url}
  canonical={`https://olaoluwamichael.vercel.app/imagination/${artwork.slug}`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: artwork.title,
    image: artwork.image_url,
    description: artwork.caption || artwork.story,
    artMedium: 'Digital illustration',
    artform: 'Faith-based stickman artwork',
    creator: { '@type': 'Person', name: 'Olaoluwa Michael' },
    url: `https://olaoluwamichael.vercel.app/imagination/${artwork.slug}`,
  }}
>
  <div>
    <nav class="wrap pt-6 sm:pt-10" aria-label="Breadcrumb">
      <a href="/imagination" class="link-arrow text-muted"><span aria-hidden="true">←</span> Imagination World</a>
    </nav>

    <section class="wrap grid items-start gap-12 pb-20 pt-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:pb-28">
      <figure class="frame mx-auto w-full max-w-xl rise lg:sticky lg:top-28">
        <ArtFrame src={artwork.image_url} alt={artwork.alt_text || artwork.title} width={1280} eager sizes="(min-width: 1024px) 560px, 92vw" />
      </figure>

      <div class="rise rise-1 lg:pt-4">
        {artwork.category && <p class="eyebrow">{artwork.category}</p>}
        <h1 class="display mt-4 text-[2.8rem] sm:text-[4rem]">{artwork.title}</h1>
        {artwork.caption && <p class="mt-4 font-display text-[1.6rem] italic leading-snug text-accent sm:text-[1.9rem]">{artwork.caption}</p>}

        {artwork.story && (
          <div class="mt-10">
            <p class="eyebrow-muted">The meaning</p>
            <p class="mt-4 whitespace-pre-line font-serif text-[1.15rem] leading-[1.8] text-ink">{artwork.story}</p>
          </div>
        )}

        {artwork.moral_quote && (
          <blockquote class="mt-10 border-y border-line py-8 text-center">
            <p class="font-display text-[1.7rem] italic leading-snug text-ink">“{artwork.moral_quote}”</p>
          </blockquote>
        )}

        <div class="mt-10">
          <a href={artwork.image_url} target="_blank" rel="noopener noreferrer" download class="btn btn-ghost">Open or save the artwork</a>
          <p class="meta mt-4 max-w-md leading-relaxed">The public version is watermarked and shared for reflection, not for sale.</p>
          <ShareActions title={artwork.title} url={shareUrl} label="Share this artwork" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
