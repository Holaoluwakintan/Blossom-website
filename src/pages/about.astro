---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtFrame from '../components/ArtFrame.astro';

const services = [
  {
    number: '01',
    icon: '⚡',
    title: 'AI & Creative Technology',
    text: 'AI visuals, AI-assisted creative workflows and prompt engineering.',
  },
  {
    number: '02',
    icon: '🎨',
    title: 'Visual Design',
    text: 'Book covers, social media campaigns, promotional graphics and branding.',
  },
  {
    number: '03',
    icon: '🎬',
    title: 'Video & Motion',
    text: 'Short-form video, motion graphics and AI-assisted video production.',
  },
  {
    number: '04',
    icon: '✍️',
    title: 'Writing & Editing',
    text: 'Books, articles, copy editing, proofreading and storytelling.',
  },
  {
    number: '05',
    icon: '💻',
    title: 'Website Development',
    text: 'Modern websites for creators, authors, organizations and businesses.',
  },
  {
    number: '06',
    icon: '🎓',
    title: 'AI Training',
    text: 'AI fundamentals, prompting, creative AI and practical AI workflows.',
  },
];

const pillars = [
  {
    number: '01',
    title: 'Faith-Rooted Storytelling',
    text: 'Stories, reflections, and books designed to carry invisible truths, make people pause, and leave them closer to Jesus.',
  },
  {
    number: '02',
    title: 'Stickman Imagination',
    text: 'A signature visual style turning life lessons, everyday scenarios, and spiritual depth into clear, accessible visual art.',
  },
  {
    number: '03',
    title: 'Creative Technology',
    text: 'Harnessing modern AI, design craft, and digital platforms to give ambitious ideas a visible, memorable form.',
  },
];

const banner = 'https://rlbrhpjljjgpqpqjrpkc.supabase.co/storage/v1/object/public/artworks/stickmans/WhatsApp%20Image%202026-08-19%20at%204.50.48%20PM%20(2).jpeg';

const channels = [
  { title: 'WhatsApp Channel', text: 'Daily stories, stickman creativity and faith reflections, straight to your WhatsApp.', cta: 'Follow the channel', href: 'https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x', external: true },
  { title: 'Facebook', text: 'Join the growing BLOSSOM community. Like, comment and share daily reflections.', cta: 'Follow on Facebook', href: 'https://www.facebook.com/share/1DTMt74HuT/', external: true },
  { title: 'Direct WhatsApp', text: 'Have a project, book enquiry or creative idea? Message me directly.', cta: 'Message me', href: 'https://wa.me/2348148034092', external: true },
  { title: 'Email', text: 'For speaking, formal collaborations and partnerships, write to my inbox.', cta: 'Send an email', href: 'mailto:michaelolaoluwagab@gmail.com', external: false },
];
---

<BaseLayout
  title="Olaoluwa Michael | Creator, Author & AI Creative Specialist"
  description="Olaoluwa Michael — writer, creative storyteller, AI creative specialist, and founder of BLOSSOM. Work with Olaoluwa on creative technology, design, writing, and web development."
>
  <div class="overflow-hidden">
    <!-- Portrait hero -->
    <section class="wrap grid items-center gap-14 pb-16 pt-12 sm:pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20 lg:pb-28 lg:pt-24">
      <div>
        <p class="eyebrow rise">Founder of BLOSSOM</p>
        <h1 class="display rise rise-1 mt-6 text-[3.8rem] sm:text-[5.4rem] lg:text-[6.4rem]">Olaoluwa <em>Michael</em></h1>
        <p class="rise rise-1 mt-5 font-display text-[1.35rem] italic text-ink-2 sm:text-2xl">Author · AI creative specialist · Storyteller · Digital builder</p>
        <p class="lede rise rise-2 mt-7 max-w-xl">
          I build at the intersection of imagination, faith and modern technology. Through books, stickman storytelling and creative consultancy,
          I help bring ideas into something people can see, read, experience and remember.
        </p>
        <div class="rise rise-3 mt-9 flex flex-wrap gap-3">
          <a href="#work-with-me" class="btn btn-primary">Work with me</a>
          <a href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2x" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">WhatsApp Channel</a>
        </div>
      </div>

      <figure class="rise rise-2 mx-auto w-full max-w-[22rem] lg:ml-auto">
        <div class="frame">
          <img src="/olaoluwa-michael.jpg" alt="Olaoluwa Michael - Writer, Storyteller and AI Creative Specialist" width="683" height="1024" class="aspect-[4/5] w-full object-cover object-top" loading="eager" fetchpriority="high" />
        </div>
        <figcaption class="mt-4 flex items-baseline justify-between gap-4">
          <span class="font-display text-xl text-ink">Olaoluwa Michael</span>
          <span class="chip chip-accent">Available for projects</span>
        </figcaption>
      </figure>
    </section>

    <!-- Vision -->
    <section class="band hairline-t hairline-b">
      <div class="wrap grid gap-14 py-20 sm:py-28 lg:grid-cols-[1fr_1fr] lg:gap-24">
        <div class="reveal">
          <p class="eyebrow">The vision</p>
          <h2 class="mt-4 text-balance font-display text-[2.5rem] leading-[1.06] sm:text-[3.4rem]">Stories that awaken courage and faith.</h2>
          <div class="prose-literary mt-8 text-[1.12rem]">
            <p>I believe every human being carries an appetite for stories that mean something. At BLOSSOM, I craft narratives, reflections and artwork built to outlast the noise of modern feeds.</p>
            <p>From writing Christian books to developing stickman visual stories and running prompt engineering workshops, everything is designed to inspire genuine reflection and leave people closer to God.</p>
          </div>
        </div>
        <div class="divide-y divide-line border-y border-line">
          {pillars.map((pillar, i) => (
            <article class={`py-8 reveal reveal-d${i + 1}`}>
              <p class="font-display text-lg italic text-accent">{pillar.number}</p>
              <h3 class="mt-2 font-display text-[1.9rem] leading-tight">{pillar.title}</h3>
              <p class="mt-3 font-serif text-[1.05rem] leading-relaxed text-ink-2">{pillar.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Artwork -->
    <section class="wrap py-20 sm:py-24">
      <figure class="mx-auto max-w-md reveal">
        <div class="frame"><ArtFrame src={banner} alt="The Invisible Step, a watermarked BLOSSOM stickman artwork" ratio="2 / 3" width={960} sizes="(min-width: 640px) 420px, 90vw" /></div>
        <figcaption class="mt-5 text-center font-display text-lg italic text-ink-2">Imagination World · faith made visible</figcaption>
      </figure>
    </section>

    <!-- Work with me -->
    <section id="work-with-me" class="theme-night scroll-mt-20 bg-paper">
      <div class="wrap py-20 sm:py-28">
        <div class="max-w-3xl reveal">
          <p class="eyebrow">Work with me</p>
          <h2 class="mt-4 text-balance font-display text-[2.4rem] leading-[1.08] sm:text-[3.4rem]">Have an idea? Let’s turn it into something people can see, read, experience or remember.</h2>
          <p class="lede mt-6">Whether you are an author, creator, brand, ministry or business, I combine creative craft with modern technology to deliver work that stands out with depth and distinction.</p>
        </div>

        <div class="mt-16 grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service, i) => (
            <a href={`mailto:michaelolaoluwagab@gmail.com?subject=${encodeURIComponent(`Enquiry: ${service.title}`)}`} class={`group flex flex-col border-b border-line py-9 sm:px-8 sm:[&:nth-child(odd)]:border-r lg:[&:nth-child(odd)]:border-r-0 lg:[&:not(:nth-child(3n))]:border-r lg:first:pl-0 lg:[&:nth-child(4)]:pl-0 sm:[&:nth-child(odd)]:pl-0 reveal reveal-d${(i % 3) + 1}`}>
              <span class="font-display text-lg italic text-accent">{service.number}</span>
              <h3 class="mt-3 font-display text-[1.75rem] leading-tight transition-colors group-hover:text-accent">{service.title}</h3>
              <p class="mt-3 font-serif text-[1.05rem] leading-relaxed text-ink-2">{service.text}</p>
              <span class="link-arrow mt-6 text-ink-2">Enquire <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>

        <div class="mt-16 flex flex-col gap-8 border border-line p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-xl">
            <p class="eyebrow">Let’s collaborate</p>
            <h3 class="mt-3 font-display text-[2.2rem] leading-tight">Start a project.</h3>
            <p class="mt-3 font-serif text-[1.05rem] leading-relaxed text-ink-2">Tell me about your vision, timeline and goals. I’ll help map out the creative roadmap and bring it to life.</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="mailto:michaelolaoluwagab@gmail.com?subject=Start%20a%20Project%20with%20Olaoluwa" class="btn btn-gold">Start a project</a>
            <a href="https://wa.me/2348148034092?text=Hello%20Olaoluwa,%20I%20have%20an%20idea%20for%20a%20project%20I%20would%20like%20to%20discuss." target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Chat on WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Community -->
    <section class="wrap py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center reveal">
        <p class="eyebrow">Join the community</p>
        <h2 class="mt-4 font-display text-[2.4rem] leading-tight sm:text-[3.2rem]">Follow the stories and reflections.</h2>
        <p class="lede mx-auto mt-5">Daily Christian stories, stickman visual reflections, creative experiments and news of new books.</p>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((c) => (
          <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined} class="group flex flex-col bg-surface p-7 transition-colors hover:bg-paper sm:p-8">
            <h3 class="font-display text-[1.6rem] leading-tight transition-colors group-hover:text-accent">{c.title}</h3>
            <p class="mt-3 flex-1 font-serif leading-relaxed text-ink-2">{c.text}</p>
            <span class="link-arrow mt-6">{c.cta} <span aria-hidden="true">{c.external ? '↗' : '→'}</span></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
