---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="About | BLOSSOM"
  description="Learn about Olaoluwa Michael and the faith-rooted creative world behind BLOSSOM."
>
  <main class="bg-[#02050B] text-[#F6F3EC] overflow-hidden">
    <section class="relative overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(232,200,104,0.15),transparent_34%),radial-gradient(circle_at_15%_80%,rgba(232,200,104,0.08),transparent_30%)]"></div>
      <div class="relative max-w-5xl mx-auto px-6 py-24 lg:py-32 text-center">
        <p class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.35em] text-[#E8C868] mb-7">About BLOSSOM</p>
        <h1 class="font-cinzel text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight">A creative world<br /><span class="font-editorial italic font-normal text-[#E8C868]">with purpose.</span></h1>
        <p class="max-w-2xl mx-auto mt-8 text-base sm:text-lg leading-8 text-slate-400">BLOSSOM is the creative home of Olaoluwa Michael—a growing ecosystem of stories, visual imagination, and faith-rooted ideas made to leave something meaningful in the heart.</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20">
        <div>
          <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#E8C868]">The person behind the work</p>
          <h2 class="font-cinzel text-3xl sm:text-4xl font-bold leading-tight mt-5">Stories, images, and ideas that point somewhere.</h2>
        </div>
        <div class="space-y-6 text-slate-400 leading-8">
          <p>Olaoluwa Michael is a writer and creative storyteller interested in the places where imagination, truth, and faith meet. Through books and visual work, he creates experiences that invite people to think deeply, feel honestly, and look again at the world around them.</p>
          <p>BLOSSOM is more than a collection of finished works. It is a living creative space for stories that challenge, images that reflect, and ideas that encourage hope.</p>
          <p>The work is rooted in a simple belief: creativity can be beautiful while still carrying purpose, and a good story can leave a person closer to truth, courage, and Jesus.</p>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#050A12]">
      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">
        <div class="grid md:grid-cols-3 gap-10">
          <div><p class="font-cinzel text-2xl text-[#E8C868]">01</p><h2 class="font-cinzel text-2xl font-bold mt-4">Writing</h2><p class="text-sm leading-7 text-slate-400 mt-4">Fiction, reflections, and stories built to open new worlds and stay with readers after the final page.</p></div>
          <div><p class="font-cinzel text-2xl text-[#E8C868]">02</p><h2 class="font-cinzel text-2xl font-bold mt-4">Imagination</h2><p class="text-sm leading-7 text-slate-400 mt-4">Watermarked visual reflections and creative experiments that give faith and feeling a visible form.</p></div>
          <div><p class="font-cinzel text-2xl text-[#E8C868]">03</p><h2 class="font-cinzel text-2xl font-bold mt-4">Collaboration</h2><p class="text-sm leading-7 text-slate-400 mt-4">A place for thoughtful creative partnerships, storytelling projects, and work that serves a meaningful purpose.</p></div>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-20 lg:py-28 text-center">
      <p class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#E8C868]">Come further in</p>
      <h2 class="font-cinzel text-3xl sm:text-5xl font-bold mt-5">Explore the world.</h2>
      <p class="text-slate-400 leading-8 mt-5 max-w-2xl mx-auto">Start with a book, spend time in Imagination World, or return soon for the Faith Journal.</p>
      <div class="flex flex-wrap justify-center gap-4 mt-9">
        <a href="/books" class="inline-flex px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-colors">Explore Books</a>
        <a href="/imagination" class="inline-flex px-8 py-4 border border-[#E8C868]/50 text-[#E8C868] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#E8C868] hover:text-[#02050B] transition-colors">Enter Imagination</a>
      </div>
    </section>
  </main>
</BaseLayout>
