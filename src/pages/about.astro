---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'AI Creative Services',
    text: 'AI-powered visual creation, prompt engineering, image generation, creative concepts and practical AI workflows designed to turn ideas into finished creative work.'
  },
  {
    number: '02',
    title: 'Content Creation',
    text: 'Creative content for brands, individuals and organizations — from concepts and storytelling to social media visuals and engaging digital campaigns.'
  },
  {
    number: '03',
    title: 'AI Training & Education',
    text: 'Practical AI training for beginners, creators, businesses and professionals who want to understand how to use AI effectively in their everyday work.'
  },
  {
    number: '04',
    title: 'Digital Marketing',
    text: 'Social media strategy, content planning, audience engagement and practical digital marketing guidance designed to help ideas reach the right people.'
  },
  {
    number: '05',
    title: 'Creative Design',
    text: 'Graphic design, visual communication, branding, promotional artwork, book promotion and creative campaign development.'
  },
  {
    number: '06',
    title: 'Creative Collaboration',
    text: 'I am open to meaningful collaborations with creators, brands, organizations, churches, publishers and individuals with ideas worth bringing to life.'
  }
];

const community = [
  {
    number: '01',
    title: 'Daily Christian Stories',
    text: 'I create and share daily Christian stories, reflections and visual content designed to make people think, laugh, reflect and ultimately draw closer to Jesus.'
  },
  {
    number: '02',
    title: 'Stickman Stories',
    text: 'My distinctive stickman storytelling style turns everyday situations, Bible stories and invisible truths into simple visual experiences people can easily connect with.'
  },
  {
    number: '03',
    title: 'Creative Experiments',
    text: 'I constantly experiment with AI, storytelling, visual creativity and technology — and share what I learn along the way.'
  }
];
---

<BaseLayout>
  <main class="min-h-screen bg-[#02050B] text-[#F6F3EC]">

    <!-- =========================================================
         HERO
    ========================================================== -->
    <section class="relative overflow-hidden">

      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[550px] bg-[radial-gradient(circle,rgba(232,200,104,0.13),transparent_65%)]"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-24 lg:pt-28 lg:pb-32">

        <p class="text-xs font-mono uppercase tracking-[0.35em] text-[#E8C868] mb-7">
          ABOUT OLAOLUWA MICHAEL
        </p>

        <h1 class="font-cinzel text-5xl sm:text-6xl lg:text-8xl font-bold leading-[0.95] max-w-6xl">
          Writer.
          <span class="italic font-editorial font-normal text-[#E8C868]">
            Creator.
          </span>
          <br />
          Technologist.
          <span class="block italic font-editorial font-normal text-[#E8C868] mt-2">
            AI Practitioner.
          </span>
        </h1>

        <p class="max-w-3xl text-slate-300 text-lg sm:text-xl leading-relaxed mt-10">
          I am Olaoluwa Michael — a writer, content creator, editor,
          designer, Computer Science graduate and AI creative specialist
          passionate about turning ideas into stories, visuals,
          experiences and useful digital solutions.
        </p>

        <div class="flex flex-wrap gap-4 mt-10">

          <a
            href="#work-with-me"
            class="inline-flex items-center justify-center px-7 py-4 bg-[#E8C868] text-[#02050B] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-colors"
          >
            Work With Me →
          </a>

          <a
            href="#community"
            class="inline-flex items-center justify-center px-7 py-4 border border-white/20 text-[#F6F3EC] font-mono text-xs font-bold uppercase tracking-widest hover:border-[#E8C868] hover:text-[#E8C868] transition-colors"
          >
            Join My Community
          </a>

        </div>

      </div>

    </section>


    <!-- =========================================================
         WHO I AM
    ========================================================== -->
    <section class="border-y border-white/10">

      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

          <div class="lg:col-span-4">

            <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
              Who I Am
            </p>

            <h2 class="font-cinzel text-3xl sm:text-4xl font-bold mt-5 leading-tight">
              A creative mind
              <span class="italic font-editorial font-normal text-[#E8C868]">
                in many worlds.
              </span>
            </h2>

          </div>

          <div class="lg:col-span-8 space-y-6 text-slate-400 text-lg leading-8">

            <p>
              I am a Computer Science graduate whose journey has taken me
              through writing, editing, graphic design, video editing,
              content creation, digital marketing and Artificial Intelligence.
            </p>

            <p>
              My journey into AI began from a simple curiosity:
              <span class="text-[#F6F3EC]">
                how can I make the work I already do faster, smarter and better?
              </span>
            </p>

            <p>
              What started as an attempt to simplify my creative workflow
              became a much deeper journey into Artificial Intelligence.
              I began experimenting with AI tools, learning prompt
              engineering, creating images and videos, developing content
              systems and discovering entirely new ways to communicate ideas.
            </p>

            <p>
              Today, I combine technology and creativity to create work
              that is not only visually interesting, but meaningful.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         WHAT I CREATE
    ========================================================== -->
    <section>

      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="max-w-3xl">

          <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
            What I Create
          </p>

          <h2 class="font-cinzel text-4xl sm:text-5xl lg:text-6xl font-bold mt-5 leading-tight">
            Ideas should not
            <span class="italic font-editorial font-normal text-[#E8C868]">
              remain ideas.
            </span>
          </h2>

          <p class="text-slate-400 text-lg leading-8 mt-7">
            I enjoy taking something that exists only in someone's mind
            and helping turn it into something people can see, read,
            experience or share.
          </p>

        </div>


        <div class="grid md:grid-cols-3 gap-px bg-white/10 border border-white/10 mt-16">

          <article class="bg-[#02050B] p-8 sm:p-10">

            <span class="text-[#E8C868] font-mono text-xs">
              01
            </span>

            <h3 class="font-cinzel text-2xl font-bold mt-6">
              Stories
            </h3>

            <p class="text-slate-400 leading-7 mt-5">
              Books, Christian stories, reflections, articles and
              storytelling designed to communicate ideas that stay with people.
            </p>

          </article>


          <article class="bg-[#02050B] p-8 sm:p-10">

            <span class="text-[#E8C868] font-mono text-xs">
              02
            </span>

            <h3 class="font-cinzel text-2xl font-bold mt-6">
              Imagination
            </h3>

            <p class="text-slate-400 leading-7 mt-5">
              AI-powered artwork, stickman stories, visual experiments
              and creative concepts that turn invisible ideas into visible experiences.
            </p>

          </article>


          <article class="bg-[#02050B] p-8 sm:p-10">

            <span class="text-[#E8C868] font-mono text-xs">
              03
            </span>

            <h3 class="font-cinzel text-2xl font-bold mt-6">
              Technology
            </h3>

            <p class="text-slate-400 leading-7 mt-5">
              AI workflows, websites, digital products and technology
              used as tools for solving creative and practical problems.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================================
         SERVICES
    ========================================================== -->
    <section
      id="work-with-me"
      class="border-y border-white/10 bg-[#080D16]"
    >

      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

          <div class="lg:col-span-4">

            <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
              Work With Me
            </p>

            <h2 class="font-cinzel text-4xl sm:text-5xl font-bold mt-5 leading-tight">
              Have a project?
              <span class="block italic font-editorial font-normal text-[#E8C868]">
                Let's build it.
              </span>
            </h2>

            <p class="text-slate-400 leading-7 mt-7">
              If you have an idea, project, campaign or problem you want
              to solve creatively, let's talk about it.
            </p>

          </div>


          <div class="lg:col-span-8">

            <div class="grid sm:grid-cols-2 gap-px bg-white/10 border border-white/10">

              {services.map((service) => (
                <article class="bg-[#080D16] p-7 sm:p-9">

                  <span class="text-[#E8C868] font-mono text-xs">
                    {service.number}
                  </span>

                  <h3 class="font-cinzel text-xl sm:text-2xl font-bold mt-5">
                    {service.title}
                  </h3>

                  <p class="text-slate-400 text-sm sm:text-base leading-7 mt-4">
                    {service.text}
                  </p>

                </article>
              ))}

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         HOW TO COLLABORATE
    ========================================================== -->
    <section>

      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="max-w-3xl">

          <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
            Collaboration
          </p>

          <h2 class="font-cinzel text-4xl sm:text-5xl font-bold mt-5">
            Let's make something
            <span class="italic font-editorial font-normal text-[#E8C868]">
              worth remembering.
            </span>
          </h2>

          <p class="text-slate-400 text-lg leading-8 mt-7">
            I am open to collaborations that combine creativity,
            storytelling, technology, faith and innovation.
          </p>

        </div>


        <div class="grid sm:grid-cols-3 gap-8 mt-14">

          <div class="border-l border-[#E8C868] pl-6">

            <span class="text-xs font-mono text-[#E8C868]">
              FOR BRANDS
            </span>

            <p class="text-slate-400 leading-7 mt-4">
              Creative campaigns, AI-powered visuals, content and
              digital storytelling.
            </p>

          </div>


          <div class="border-l border-[#E8C868] pl-6">

            <span class="text-xs font-mono text-[#E8C868]">
              FOR CREATORS
            </span>

            <p class="text-slate-400 leading-7 mt-4">
              Creative projects, content collaborations, storytelling
              and AI experimentation.
            </p>

          </div>


          <div class="border-l border-[#E8C868] pl-6">

            <span class="text-xs font-mono text-[#E8C868]">
              FOR ORGANIZATIONS
            </span>

            <p class="text-slate-400 leading-7 mt-4">
              AI education, digital marketing, creative training and
              technology-driven solutions.
            </p>

          </div>

        </div>


        <div class="mt-12">

          <a
            href="mailto:michaelolaoluwagab@gmail.com?subject=Collaboration%20with%20Olaoluwa%20Michael"
            class="inline-flex items-center justify-center px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-colors"
          >
            Discuss A Collaboration →
          </a>

        </div>

      </div>

    </section>


    <!-- =========================================================
         COMMUNITY
    ========================================================== -->
    <section
      id="community"
      class="relative overflow-hidden border-y border-white/10"
    >

      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(232,200,104,0.10),transparent_50%)]"></div>

      <div class="relative max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="text-center max-w-3xl mx-auto">

          <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
            Join The Community
          </p>

          <h2 class="font-cinzel text-4xl sm:text-5xl lg:text-6xl font-bold mt-5 leading-tight">
            Don't just follow the work.
            <span class="block italic font-editorial font-normal text-[#E8C868]">
              Come be part of it.
            </span>
          </h2>

          <p class="text-slate-400 text-lg leading-8 mt-7">
            I create and share content regularly across my communities,
            especially Christian stories, reflections, creative experiments
            and practical lessons from my journey with AI and technology.
          </p>

        </div>


        <!-- Community pillars -->

        <div class="grid md:grid-cols-3 gap-8 mt-16">

          {community.map((item) => (
            <article class="border border-white/10 bg-[#080D16] p-8 sm:p-10">

              <span class="text-[#E8C868] font-mono text-xs">
                {item.number}
              </span>

              <h3 class="font-cinzel text-2xl font-bold mt-6">
                {item.title}
              </h3>

              <p class="text-slate-400 leading-7 mt-5">
                {item.text}
              </p>

            </article>
          ))}

        </div>


        <!-- Community buttons -->

        <div class="flex flex-col sm:flex-row justify-center gap-4 mt-14">

          <!-- Replace this Facebook URL with your exact Facebook page/profile URL -->
          <a
            href="https://www.facebook.com/share/1DTMt74HuT/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-[#E8C868] text-[#02050B] font-mono text-xs font-bold uppercase tracking-widest hover:bg-[#F6F3EC] transition-colors"
          >
            Join Me On Facebook →
          </a>


          <!-- Replace this with your actual WhatsApp Channel URL -->
          <a
            href="https://whatsapp.com/channel/0029VaEtpDnJP21DVpo1Mi2xy"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 border border-white/20 text-[#F6F3EC] font-mono text-xs font-bold uppercase tracking-widest hover:border-[#E8C868] hover:text-[#E8C868] transition-colors"
          >
            Join WhatsApp Community →
          </a>

        </div>

        <p class="text-center text-slate-600 text-xs font-mono mt-6">
          Daily Christian stories • Stickman creativity • Faith • AI • Life
        </p>

      </div>

    </section>


    <!-- =========================================================
         CHRISTIAN CONTENT
    ========================================================== -->
    <section class="bg-[#080D16] border-b border-white/10">

      <div class="max-w-5xl mx-auto px-6 py-20 lg:py-28 text-center">

        <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
          What I Share
        </p>

        <h2 class="font-cinzel text-4xl sm:text-5xl font-bold mt-5 leading-tight">
          Every day, another story.
        </h2>

        <p class="font-editorial italic text-2xl sm:text-3xl text-[#E8C868] mt-6">
          Sometimes funny. Sometimes deep. Always meaningful.
        </p>

        <p class="text-slate-400 text-lg leading-8 max-w-3xl mx-auto mt-8">
          Through my Christian content, I explore Bible stories, everyday
          struggles, faith, hope, humour and the realities of following Jesus.
          My goal is simple: create content people can genuinely connect with
          while pointing them back to God.
        </p>

        <div class="mt-10 inline-flex items-center gap-3 px-5 py-3 border border-white/10">

          <span class="w-2 h-2 rounded-full bg-[#E8C868]"></span>

          <span class="font-mono text-xs uppercase tracking-widest text-slate-400">
            New Christian content regularly
          </span>

        </div>

      </div>

    </section>


    <!-- =========================================================
         CONTACT
    ========================================================== -->
    <section>

      <div class="max-w-7xl mx-auto px-6 py-20 lg:py-28">

        <div class="border border-white/10 bg-[#080D16] p-8 sm:p-12 lg:p-16">

          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

            <div>

              <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#E8C868]">
                Let's Talk
              </p>

              <h2 class="font-cinzel text-4xl sm:text-5xl font-bold mt-5 leading-tight">
                Have a question,
                <span class="block italic font-editorial font-normal text-[#E8C868]">
                  idea or opportunity?
                </span>
              </h2>

              <p class="text-slate-400 text-lg leading-7 mt-7">
                Whether you want to collaborate, request a service,
                invite me to teach, discuss a creative project or simply
                say hello, you can reach me directly.
              </p>

            </div>


            <div class="space-y-4">

              <a
                href="mailto:michaelolaoluwagab@gmail.com"
                class="flex items-center justify-between border border-white/10 px-6 py-5 hover:border-[#E8C868] transition-colors group"
              >

                <div>
                  <p class="text-[10px] font-mono uppercase tracking-widest text-[#E8C868]">
                    Email
                  </p>

                  <p class="text-slate-300 mt-2 text-sm sm:text-base">
                    michaelolaoluwagab@gmail.com
                  </p>
                </div>

                <span class="text-[#E8C868] group-hover:translate-x-1 transition-transform">
                  →
                </span>

              </a>


              <a
                href="https://wa.me/2348148034092"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between border border-white/10 px-6 py-5 hover:border-[#E8C868] transition-colors group"
              >

                <div>
                  <p class="text-[10px] font-mono uppercase tracking-widest text-[#E8C868]">
                    WhatsApp
                  </p>

                  <p class="text-slate-300 mt-2 text-sm sm:text-base">
                    Message me directly
                  </p>
                </div>

                <span class="text-[#E8C868] group-hover:translate-x-1 transition-transform">
                  →
                </span>

              </a>


              <a
                href="/"
                class="flex items-center justify-between border border-white/10 px-6 py-5 hover:border-[#E8C868] transition-colors group"
              >

                <div>
                  <p class="text-[10px] font-mono uppercase tracking-widest text-[#E8C868]">
                    BLOSSOM
                  </p>

                  <p class="text-slate-300 mt-2 text-sm sm:text-base">
                    Explore the full creative world
                  </p>
                </div>

                <span class="text-[#E8C868] group-hover:translate-x-1 transition-transform">
                  →
                </span>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         FINAL STATEMENT
    ========================================================== -->
    <section class="border-t border-white/10">

      <div class="max-w-5xl mx-auto px-6 py-24 lg:py-32 text-center">

        <p class="text-xs font-mono uppercase tracking-[0.35em] text-[#E8C868]">
          BLOSSOM
        </p>

        <blockquote class="font-editorial text-3xl sm:text-4xl lg:text-5xl leading-tight mt-8">
          “Every story leaves something behind.
          <span class="text-[#E8C868]">
            Let these leave you closer to Jesus.
          </span>”
        </blockquote>

        <div class="mt-12">

          <a
            href="/"
            class="inline-flex items-center text-xs font-mono uppercase tracking-widest text-slate-500 hover:text-[#E8C868] transition-colors"
          >
            ← Back to Home
          </a>

        </div>

      </div>

    </section>

  </main>
</BaseLayout>