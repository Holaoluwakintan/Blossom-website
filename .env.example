# Copy to .env for local dev. Set the real values in Vercel -> Project -> Settings -> Environment Variables.

PUBLIC_SITE_URL=https://olaoluwamichael.vercel.app
PUBLIC_SUPABASE_URL=https://rlbrhpjljjgpqpqjrpkc.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PAYSTACK_SECRET_KEY=

# --- Newsletter ---
# Email provider: set ONE of these. Brevo is free (300 emails/day) and works with a verified Gmail sender.
BREVO_API_KEY=
# ...or Brevo over SMTP (Brevo -> SMTP & API -> SMTP shows the login; the key starts with xsmtpsib-)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
RESEND_API_KEY=
# Sender address, verified with the provider above (e.g. your Gmail in Brevo -> Senders).
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=Olaoluwa Michael
NEWSLETTER_REPLY_TO=
# Long random strings. NEWSLETTER_SECRET protects /api/newsletter/* and signs unsubscribe links.
# CRON_SECRET is sent automatically by Vercel Cron to /api/newsletter/dispatch.
NEWSLETTER_SECRET=
CRON_SECRET=
# Optional: which content is announced (journal,books) and how far back to look (days).
NEWSLETTER_CONTENT=journal,books
NEWSLETTER_LOOKBACK_DAYS=7

# Optional download-token signing secret (falls back to the service role key).
DOWNLOAD_TOKEN_SECRET=

# Telegram journal bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
