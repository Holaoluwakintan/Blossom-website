{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/about\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/comments\\/submit\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/views\\/track\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/books\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/books\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/imagination\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/imagination\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}